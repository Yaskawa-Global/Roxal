@dataflow_diagram(version=1, next_id=15)

import flipflop
import logic
import web
import fileio
import inspect

type Counter4 object:
  @df(id=1, x=20, y=40, payload='bool')
  var en:signal = nil
  @df(id=3, x=600, y=40)
  var q0:signal = nil
  @df(id=5, x=600, y=130)
  var q1:signal = nil
  @df(id=7, x=600, y=220)
  var q2:signal = nil
  @df(id=9, x=600, y=310)
  var q3:signal = nil
  @df(id=13, x=600, y=400, probe=true)
  var value:signal = nil

  proc init(en:signal, freq:real=4):
    this.en = en
    @df(id=2, x=260, y=40, diagram='flipflop', outs='q')
    var flipflop_2 = flipflop.FlipFlop(en, freq=freq)
    @df(id=10, x=120, y=130)
    var and_gate = logic.and_gate(flipflop_2.q, en)
    @df(id=4, x=260, y=130, diagram='flipflop', outs='q')
    var flipflop_3 = flipflop.FlipFlop(and_gate, freq=freq)
    @df(id=11, x=120, y=220)
    var and_gate_2 = logic.and_gate(flipflop_3.q, and_gate)
    @df(id=6, x=260, y=220, diagram='flipflop', outs='q')
    var flipflop_4 = flipflop.FlipFlop(and_gate_2, freq=freq)
    @df(id=12, x=120, y=310)
    var and_gate_3 = logic.and_gate(flipflop_4.q, and_gate_2)
    @df(id=8, x=260, y=310, diagram='flipflop', outs='q')
    var flipflop_5 = flipflop.FlipFlop(and_gate_3, freq=freq)
    @df(id=14, x=450, y=400)
    var packed = logic.pack4(flipflop_2.q, flipflop_3.q, flipflop_4.q, flipflop_5.q)
    q0 = flipflop_2.q
    q1 = flipflop_3.q
    q2 = flipflop_4.q
    q3 = flipflop_5.q
    value = packed
var __in_en = signal(4, false)
__in_en <- logic.not_gate(__in_en[-1])
var __c = Counter4(__in_en)
when __c.value changes as __e:
  print('value = ' + string(__e.value))

// Transplant of the IDE-only ingredient: file I/O through fileio (OPFS-backed
// in a browser), which routes every op through AsyncIOManager's worker thread.
// The bare page previously wrote its files with JS FS.writeFile, so that
// thread never even started.
var __io = 0
when __c.value changes as __ev:
  __io = __io + 1
  var p = '/data/churn' + string(__io rem 4) + '.txt'
  var fh = fileio.open(p, write=true)
  fileio.write(fh, 'payload-' + string(__io))
  fileio.close(fh)
  var rh = fileio.open(p)
  var t = fileio.read(rh)
  fileio.close(rh)


// Store traffic the page can actually drive: a store this script owns, with a
// method that builds mirror graphs like the IDE's language service does.
// An ACTOR, like the IDE's ide/workspace/df stores: a store method call is
// dispatched through the actor queue, and a plain object's never resolves.
type Probe actor:
  private var ticks: int = 0
  func sample() -> dict:
    ticks = ticks + 1
    var net = inspect.signals()
    return {'ok': true, 'n': len(net), 'ticks': ticks}

var __p = Probe()
web.expose('probe', __p)

web.serve()

