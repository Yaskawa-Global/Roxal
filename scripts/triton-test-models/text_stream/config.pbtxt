backend: "python"
max_batch_size: 0
model_transaction_policy { decoupled: true }
input [
  { name: "text" data_type: TYPE_STRING dims: [ 1 ] },
  { name: "n" data_type: TYPE_INT32 dims: [ 1 ] optional: true }
]
output [
  { name: "piece" data_type: TYPE_STRING dims: [ 1 ] }
]
instance_group [ { kind: KIND_CPU } ]
