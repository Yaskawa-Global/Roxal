# Live object detection: camera frames -> ai.nn (D-FINE nano, ONNX) -> opencv
# annotation -> qt.FrameView. Demonstrates the opencv <-> ai.nn tensor interop:
# opencv.to_blob() produces the NCHW float32 input Model.predict() expects.
#
# Run from the repo root:  ./build/roxal examples/opencv-detect.rox
# Close the window to exit. Falls back to tests/testvideo.mp4 without a camera.

import opencv.*
import ai.nn
import math.*
import qt

var coco = ['person', 'bicycle', 'car', 'motorcycle', 'airplane', 'bus', 'train',
  'truck', 'boat', 'traffic light', 'fire hydrant', 'stop sign', 'parking meter',
  'bench', 'bird', 'cat', 'dog', 'horse', 'sheep', 'cow', 'elephant', 'bear',
  'zebra', 'giraffe', 'backpack', 'umbrella', 'handbag', 'tie', 'suitcase',
  'frisbee', 'skis', 'snowboard', 'sports ball', 'kite', 'baseball bat',
  'baseball glove', 'skateboard', 'surfboard', 'tennis racket', 'bottle',
  'wine glass', 'cup', 'fork', 'knife', 'spoon', 'bowl', 'banana', 'apple',
  'sandwich', 'orange', 'broccoli', 'carrot', 'hot dog', 'pizza', 'donut',
  'cake', 'chair', 'couch', 'potted plant', 'bed', 'dining table', 'toilet',
  'tv', 'laptop', 'mouse', 'remote', 'keyboard', 'cell phone', 'microwave',
  'oven', 'toaster', 'sink', 'refrigerator', 'book', 'clock', 'vase',
  'scissors', 'teddy bear', 'hair drier', 'toothbrush']

var cap
var from_file = false
try:
  cap = open_camera(0)
  print("camera 0: {cap.width} x {cap.height}")
except e:
  print('no camera available; playing tests/testvideo.mp4')
  cap = open_video('tests/testvideo.mp4')
  from_file = true

var model = ai.nn.Model('modules/ai/dfine_nano_fp32.onnx')
print('D-FINE nano loaded on ' + model.device())

var eng = qt.Engine()
var qml = 'import QtQuick\nimport QtQuick.Window\nimport Roxal\n'
qml = qml + 'Window { visible: true; width: ' + string(cap.width) + '; height: ' + string(cap.height)
qml = qml + '; title: "Roxal opencv + ai.nn - D-FINE detection (close to quit)"; '
qml = qml + 'FrameView { objectName: "fb"; anchors.fill: parent } }'
eng.load_string(qml)
var fb = eng.find('fb')

proc frame_tick():
  var frame = cap.read()
  if frame == nil:
    # end of a video file: restart; cameras just skip the odd empty frame
    if from_file:
      cap.set(CapProp.PosFrames, 0.0)
    return

  # opencv image tensor -> NCHW float32 blob -> ai.nn inference
  var result = model.predict(to_blob(frame, 640, 640))
  var logits = result[0]
  var boxes = result[1]

  # D-FINE: 300 queries; per query take the best class, sigmoid it for a score,
  # and scale the normalized cx,cy,w,h box back to frame pixels
  var found = 0
  for q in range(0 ..< 300):
    var cls = int(argmax(logits[0, q, 0:80]))
    var score = 1.0 / (1.0 + exp(-logits[0, q, cls]))
    if score > 0.5:
      found = found + 1
      var bw = boxes[0, q, 2] * cap.width
      var bh = boxes[0, q, 3] * cap.height
      var x = int(boxes[0, q, 0] * cap.width - bw / 2.0)
      var y = int(boxes[0, q, 1] * cap.height - bh / 2.0)
      rectangle(frame, x, y, int(bw), int(bh), [255, 60, 60], 2)
      put_text(frame, coco[cls] + ' ' + string(int(score * 100.0)) + '%',
               x, y - 6, [255, 255, 255], 0.5)
  put_text(frame, string(found) + ' objects', 8, 24, [0, 255, 0], 0.7, Font.Simplex, 2)
  fb.present(frame)

qt.every(150, frame_tick)
eng.run()
cap.close()
model.close()
