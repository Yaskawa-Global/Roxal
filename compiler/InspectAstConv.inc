static ptr<ast::File> buildFile(InspectBuild& bx, ObjectInstance* inst)
{
    auto n = roxal::make_ptr<ast::File>();
    n->imports = bx.getNodeListAs<ast::Import>(inst, "imports");
    n->declsOrStmts = bx.getDeclStmtList(inst, "decls_or_stmts");
    bx.putStrListAttr(*n, inst, "end_comments");
    return n;
}

static ptr<ast::SingleInput> buildSingleInput(InspectBuild& bx, ObjectInstance* inst)
{
    auto n = roxal::make_ptr<ast::SingleInput>();
    n->stmt = bx.getNodeAs<ast::Statement>(inst, "stmt");
    return n;
}

static ptr<ast::Annotation> buildAnnotation(InspectBuild& bx, ObjectInstance* inst)
{
    auto n = roxal::make_ptr<ast::Annotation>();
    n->name = bx.getUStr(inst, "name");
    n->args = bx.getArgList(inst, "args");
    return n;
}

static ptr<ast::Import> buildImport(InspectBuild& bx, ObjectInstance* inst)
{
    auto n = roxal::make_ptr<ast::Import>();
    n->packages = bx.getUStrList(inst, "packages");
    n->symbols = bx.getUStrList(inst, "symbols");
    return n;
}

static ptr<ast::Suite> buildSuite(InspectBuild& bx, ObjectInstance* inst)
{
    auto n = roxal::make_ptr<ast::Suite>();
    n->declsOrStmts = bx.getDeclStmtList(inst, "decls_or_stmts");
    return n;
}

static ptr<ast::ExpressionStatement> buildExpressionStatement(InspectBuild& bx, ObjectInstance* inst)
{
    auto n = roxal::make_ptr<ast::ExpressionStatement>();
    n->expr = bx.getNodeAs<ast::Expression>(inst, "expr");
    n->atHost = bx.getOptNodeAs<ast::Expression>(inst, "at_host");
    return n;
}

static ptr<ast::ReturnStatement> buildReturnStatement(InspectBuild& bx, ObjectInstance* inst)
{
    auto n = roxal::make_ptr<ast::ReturnStatement>();
    n->expr = bx.getOptNodeAs<ast::Expression>(inst, "expr");
    return n;
}

static ptr<ast::BreakStatement> buildBreakStatement(InspectBuild& bx, ObjectInstance* inst)
{
    auto n = roxal::make_ptr<ast::BreakStatement>();
