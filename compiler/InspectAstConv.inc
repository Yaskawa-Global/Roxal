ptr<ast::AST> InspectBuild::build(const Value& v)
{
    if (v.isNil()) return nullptr;
    if (!isObjectInstance(v))
        throw std::runtime_error("inspect: expected an AST mirror node, got " + v.typeName());
    ObjectInstance* inst = asObjectInstance(v);
    auto mit = memo.find(inst);
    if (mit != memo.end()) return mit->second;
    std::string kind = toUTF8StdString(asObjectType(inst->instanceType)->name);
    if (kind == "File") return memo[inst] = finish(buildFile(*this, inst), inst);
    if (kind == "SingleInput") return memo[inst] = finish(buildSingleInput(*this, inst), inst);
    if (kind == "Annotation") return memo[inst] = finish(buildAnnotation(*this, inst), inst);
    if (kind == "Import") return memo[inst] = finish(buildImport(*this, inst), inst);
    if (kind == "Suite") return memo[inst] = finish(buildSuite(*this, inst), inst);
    if (kind == "ExpressionStatement") return memo[inst] = finish(buildExpressionStatement(*this, inst), inst);
    if (kind == "ReturnStatement") return memo[inst] = finish(buildReturnStatement(*this, inst), inst);
    if (kind == "BreakStatement") return memo[inst] = finish(buildBreakStatement(*this, inst), inst);
    if (kind == "ContinueStatement") return memo[inst] = finish(buildContinueStatement(*this, inst), inst);
    if (kind == "JumpStatement") return memo[inst] = finish(buildJumpStatement(*this, inst), inst);
    if (kind == "LabelStatement") return memo[inst] = finish(buildLabelStatement(*this, inst), inst);
    if (kind == "IfStatement") return memo[inst] = finish(buildIfStatement(*this, inst), inst);
    if (kind == "WhileStatement") return memo[inst] = finish(buildWhileStatement(*this, inst), inst);
    if (kind == "ForStatement") return memo[inst] = finish(buildForStatement(*this, inst), inst);
    if (kind == "WhenStatement") return memo[inst] = finish(buildWhenStatement(*this, inst), inst);
    if (kind == "UntilStatement") return memo[inst] = finish(buildUntilStatement(*this, inst), inst);
    if (kind == "AdheringIfStatement") return memo[inst] = finish(buildAdheringIfStatement(*this, inst), inst);
    if (kind == "RaiseStatement") return memo[inst] = finish(buildRaiseStatement(*this, inst), inst);
    if (kind == "TryStatement") return memo[inst] = finish(buildTryStatement(*this, inst), inst);
    if (kind == "MatchStatement") return memo[inst] = finish(buildMatchStatement(*this, inst), inst);
    if (kind == "WithStatement") return memo[inst] = finish(buildWithStatement(*this, inst), inst);
    if (kind == "VarDecl") return memo[inst] = finish(buildVarDecl(*this, inst), inst);
    if (kind == "PropertyAccessor") return memo[inst] = finish(buildPropertyAccessor(*this, inst), inst);
    if (kind == "FuncDecl") return memo[inst] = finish(buildFuncDecl(*this, inst), inst);
    if (kind == "Function") return memo[inst] = finish(buildFunction(*this, inst), inst);
    if (kind == "Parameter") return memo[inst] = finish(buildParameter(*this, inst), inst);
    if (kind == "TypeDecl") return memo[inst] = finish(buildTypeDecl(*this, inst), inst);
    if (kind == "Assignment") return memo[inst] = finish(buildAssignment(*this, inst), inst);
    if (kind == "BinaryOp") return memo[inst] = finish(buildBinaryOp(*this, inst), inst);
    if (kind == "UnaryOp") return memo[inst] = finish(buildUnaryOp(*this, inst), inst);
    if (kind == "Variable") return memo[inst] = finish(buildVariable(*this, inst), inst);
    if (kind == "Call") return memo[inst] = finish(buildCall(*this, inst), inst);
    if (kind == "Range") return memo[inst] = finish(buildRange(*this, inst), inst);
    if (kind == "Index") return memo[inst] = finish(buildIndex(*this, inst), inst);
    if (kind == "LambdaFunc") return memo[inst] = finish(buildLambdaFunc(*this, inst), inst);
    if (kind == "Literal") return memo[inst] = finish(buildLiteral(*this, inst), inst);
    if (kind == "Bool") return memo[inst] = finish(buildBool(*this, inst), inst);
    if (kind == "Num") return memo[inst] = finish(buildNum(*this, inst), inst);
    if (kind == "Str") return memo[inst] = finish(buildStr(*this, inst), inst);
    if (kind == "StrInterp") return memo[inst] = finish(buildStrInterp(*this, inst), inst);
    if (kind == "SuffixedNum") return memo[inst] = finish(buildSuffixedNum(*this, inst), inst);
    if (kind == "SuffixedStr") return memo[inst] = finish(buildSuffixedStr(*this, inst), inst);
    if (kind == "Type") return memo[inst] = finish(buildType(*this, inst), inst);
    if (kind == "List") return memo[inst] = finish(buildList(*this, inst), inst);
    if (kind == "Vector") return memo[inst] = finish(buildVector(*this, inst), inst);
    if (kind == "Matrix") return memo[inst] = finish(buildMatrix(*this, inst), inst);
    if (kind == "Dict") return memo[inst] = finish(buildDict(*this, inst), inst);
    throw std::runtime_error("inspect: '" + kind + "' is not a standalone AST node kind");
}

void forEachChildOf(const ast::AST& node, const std::function<void(const ast::AST*)>& f)
{
    for (auto& a : node.annotations) if (a) f(a.get());
    const std::type_info& t = typeid(node);
    if (t == typeid(ast::File)) {
        auto& n = static_cast<const ast::File&>(node); (void)n;
        for (auto& e : n.imports) if (e) f(e.get());
        for (auto& e : n.declsOrStmts) { if (std::holds_alternative<ptr<ast::Declaration>>(e)) { auto& p = std::get<ptr<ast::Declaration>>(e); if (p) f(p.get()); } else { auto& p = std::get<ptr<ast::Statement>>(e); if (p) f(p.get()); } }
        return;
    }
    if (t == typeid(ast::SingleInput)) {
        auto& n = static_cast<const ast::SingleInput&>(node); (void)n;
        if (n.stmt) f(n.stmt.get());
        return;
    }
    if (t == typeid(ast::Annotation)) {
        auto& n = static_cast<const ast::Annotation&>(node); (void)n;
        for (auto& e : n.args) if (e.second) f(e.second.get());
        return;
    }
    if (t == typeid(ast::Suite)) {
        auto& n = static_cast<const ast::Suite&>(node); (void)n;
        for (auto& e : n.declsOrStmts) { if (std::holds_alternative<ptr<ast::Declaration>>(e)) { auto& p = std::get<ptr<ast::Declaration>>(e); if (p) f(p.get()); } else { auto& p = std::get<ptr<ast::Statement>>(e); if (p) f(p.get()); } }
        return;
    }
    if (t == typeid(ast::ExpressionStatement)) {
        auto& n = static_cast<const ast::ExpressionStatement&>(node); (void)n;
        if (n.expr) f(n.expr.get());
        if (n.atHost.has_value() && n.atHost.value()) f(n.atHost.value().get());
        return;
    }
    if (t == typeid(ast::ReturnStatement)) {
        auto& n = static_cast<const ast::ReturnStatement&>(node); (void)n;
        if (n.expr.has_value() && n.expr.value()) f(n.expr.value().get());
        return;
    }
    if (t == typeid(ast::IfStatement)) {
        auto& n = static_cast<const ast::IfStatement&>(node); (void)n;
        for (auto& e : n.conditionalSuites) { if (e.first) f(e.first.get()); if (e.second) f(e.second.get()); }
        if (n.elseSuite.has_value() && n.elseSuite.value()) f(n.elseSuite.value().get());
        return;
    }
    if (t == typeid(ast::WhileStatement)) {
        auto& n = static_cast<const ast::WhileStatement&>(node); (void)n;
        if (n.condition) f(n.condition.get());
        if (n.body) f(n.body.get());
        return;
    }
    if (t == typeid(ast::ForStatement)) {
        auto& n = static_cast<const ast::ForStatement&>(node); (void)n;
        for (auto& e : n.targetList) if (e) f(e.get());
        if (n.iterable) f(n.iterable.get());
        if (n.body) f(n.body.get());
        return;
    }
    if (t == typeid(ast::WhenStatement)) {
        auto& n = static_cast<const ast::WhenStatement&>(node); (void)n;
        if (n.trigger) f(n.trigger.get());
        if (n.becomes.has_value() && n.becomes.value()) f(n.becomes.value().get());
        if (n.targetFilter.has_value() && n.targetFilter.value()) f(n.targetFilter.value().get());
        if (n.body) f(n.body.get());
        return;
    }
    if (t == typeid(ast::UntilStatement)) {
        auto& n = static_cast<const ast::UntilStatement&>(node); (void)n;
        if (n.stmt) f(n.stmt.get());
        if (n.condition) f(n.condition.get());
        return;
    }
    if (t == typeid(ast::AdheringIfStatement)) {
        auto& n = static_cast<const ast::AdheringIfStatement&>(node); (void)n;
        if (n.stmt) f(n.stmt.get());
        if (n.condition) f(n.condition.get());
        return;
    }
    if (t == typeid(ast::RaiseStatement)) {
        auto& n = static_cast<const ast::RaiseStatement&>(node); (void)n;
        if (n.exception.has_value() && n.exception.value()) f(n.exception.value().get());
        return;
    }
    if (t == typeid(ast::TryStatement)) {
        auto& n = static_cast<const ast::TryStatement&>(node); (void)n;
        if (n.body) f(n.body.get());
        for (auto& e : n.exceptClauses) { if (e.type.has_value() && e.type.value()) f(e.type.value().get()); if (e.body) f(e.body.get()); }
        if (n.finallySuite.has_value() && n.finallySuite.value()) f(n.finallySuite.value().get());
        return;
    }
    if (t == typeid(ast::MatchStatement)) {
        auto& n = static_cast<const ast::MatchStatement&>(node); (void)n;
        if (n.matchExpr) f(n.matchExpr.get());
        for (auto& e : n.cases) { for (auto& p : e.first) if (p) f(p.get()); if (e.second) f(e.second.get()); }
        if (n.defaultCase.has_value() && n.defaultCase.value()) f(n.defaultCase.value().get());
        return;
    }
    if (t == typeid(ast::WithStatement)) {
        auto& n = static_cast<const ast::WithStatement&>(node); (void)n;
        if (n.contextExpr) f(n.contextExpr.get());
        if (n.body) f(n.body.get());
        return;
    }
    if (t == typeid(ast::VarDecl)) {
        auto& n = static_cast<const ast::VarDecl&>(node); (void)n;
        if (n.initializer.has_value() && n.initializer.value()) f(n.initializer.value().get());
        if (n.atHost.has_value() && n.atHost.value()) f(n.atHost.value().get());
        return;
    }
    if (t == typeid(ast::PropertyAccessor)) {
        auto& n = static_cast<const ast::PropertyAccessor&>(node); (void)n;
        if (n.initializer.has_value() && n.initializer.value()) f(n.initializer.value().get());
