    if (t == typeid(ast::SingleInput)) return convSingleInput(*this, static_cast<const ast::SingleInput&>(*n));
    if (t == typeid(ast::Annotation)) return convAnnotation(*this, static_cast<const ast::Annotation&>(*n));
    if (t == typeid(ast::Import)) return convImport(*this, static_cast<const ast::Import&>(*n));
    if (t == typeid(ast::Suite)) return convSuite(*this, static_cast<const ast::Suite&>(*n));
    if (t == typeid(ast::ExpressionStatement)) return convExpressionStatement(*this, static_cast<const ast::ExpressionStatement&>(*n));
    if (t == typeid(ast::ReturnStatement)) return convReturnStatement(*this, static_cast<const ast::ReturnStatement&>(*n));
    if (t == typeid(ast::BreakStatement)) return convBreakStatement(*this, static_cast<const ast::BreakStatement&>(*n));
    if (t == typeid(ast::ContinueStatement)) return convContinueStatement(*this, static_cast<const ast::ContinueStatement&>(*n));
    if (t == typeid(ast::JumpStatement)) return convJumpStatement(*this, static_cast<const ast::JumpStatement&>(*n));
    if (t == typeid(ast::LabelStatement)) return convLabelStatement(*this, static_cast<const ast::LabelStatement&>(*n));
    if (t == typeid(ast::IfStatement)) return convIfStatement(*this, static_cast<const ast::IfStatement&>(*n));
    if (t == typeid(ast::WhileStatement)) return convWhileStatement(*this, static_cast<const ast::WhileStatement&>(*n));
    if (t == typeid(ast::ForStatement)) return convForStatement(*this, static_cast<const ast::ForStatement&>(*n));
