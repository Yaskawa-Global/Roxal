    if (t == typeid(ast::PropertyAccessor)) return convPropertyAccessor(*this, static_cast<const ast::PropertyAccessor&>(*n));
    if (t == typeid(ast::FuncDecl)) return convFuncDecl(*this, static_cast<const ast::FuncDecl&>(*n));
    if (t == typeid(ast::Function)) return convFunction(*this, static_cast<const ast::Function&>(*n));
    if (t == typeid(ast::Parameter)) return convParameter(*this, static_cast<const ast::Parameter&>(*n));
    if (t == typeid(ast::TypeDecl)) return convTypeDecl(*this, static_cast<const ast::TypeDecl&>(*n));
    if (t == typeid(ast::Assignment)) return convAssignment(*this, static_cast<const ast::Assignment&>(*n));
