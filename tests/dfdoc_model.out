type Detect object:
  @df(id=1, x=0, y=0, payload='tensor')
  var img:signal = nil

  @df(id=5, x=800, y=0)
  var dets:signal = nil

  proc init(img:signal, freq:real=2):
    this.img = img

    @df(id=2, x=200, y=0)
    var dfine_blob = vision.dfine_blob(img)

