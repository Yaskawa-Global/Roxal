# Fused gather-blit primitives: sample_col, sample_span, remap.
# Indexed (with lut) and direct-color modes, wrap/clamp, mask, and the
# coordinate remap. Expected values hand-computed.

# 1D color-index lut used throughout: lut[i] = i + 100
var lut = tensor(shape=[64], dtype="uint8")
for i in range(..<64):
  lut[i] = i + 100

# --- sample_col: indexed + lut ---
var frame = tensor(shape=[8, 2], dtype="uint8")
var tex = tensor(shape=[4], dtype="uint8", data=[10, 20, 30, 40])
frame.sample_col(1, 2, 6, tex, 0.0, 1.0, lut=lut)   # tex[0..3] -> lut -> 110,120,130,140
print(string(int(frame[2,1])) + ' ' + string(int(frame[3,1])) + ' ' + string(int(frame[4,1])) + ' ' + string(int(frame[5,1])))
print('untouched: ' + string(int(frame[2,0])) + ' ' + string(int(frame[6,1])))

# wrap (default): base=2 -> idx 2,3,0,1
frame.sample_col(0, 0, 4, tex, 2.0, 1.0, lut=lut)
print('wrap: ' + string(int(frame[0,0])) + ' ' + string(int(frame[1,0])) + ' ' + string(int(frame[2,0])) + ' ' + string(int(frame[3,0])))

# negative base wraps correctly
var f2 = tensor(shape=[3, 1], dtype="uint8")
f2.sample_col(0, 0, 3, tex, -1.0, 1.0, lut=lut)   # idx -1,0,1 -> 3,0,1 -> 40,10,20 -> 140,110,120
print('neg: ' + string(int(f2[0,0])) + ' ' + string(int(f2[1,0])) + ' ' + string(int(f2[2,0])))

# clamp (wrap=false): idx clamps to [0,N)
var f3 = tensor(shape=[4, 1], dtype="uint8")
f3.sample_col(0, 0, 4, tex, -1.0, 1.0, lut=lut, wrap=false)  # idx -1,0,1,2 -> clamp 0,0,1,2 -> 110,110,120,130
print('clamp: ' + string(int(f3[0,0])) + ' ' + string(int(f3[1,0])) + ' ' + string(int(f3[2,0])) + ' ' + string(int(f3[3,0])))

# --- sample_col: direct color (RGB rows, no lut) ---
var img = tensor(shape=[4, 4, 3], dtype="uint8")
var ctex = tensor(shape=[2, 3], dtype="uint8", data=[1,2,3, 4,5,6])
img.sample_col(0, 0, 4, ctex, 0.0, 1.0)   # wrap N=2 -> rows 0,1,0,1
print('rgb0: ' + string(int(img[0,0,0])) + ',' + string(int(img[0,0,1])) + ',' + string(int(img[0,0,2])))
print('rgb1: ' + string(int(img[1,0,0])) + ',' + string(int(img[1,0,1])) + ',' + string(int(img[1,0,2])))
print('rgb2: ' + string(int(img[2,0,0])) + ',' + string(int(img[2,0,1])) + ',' + string(int(img[2,0,2])))

# --- sample_col: mask (transparency) ---
var fm = tensor(shape=[3, 1], dtype="uint8")
fm.fill(99)
var mtex = tensor(shape=[3], dtype="uint8", data=[10, 20, 30])
var msk = tensor(shape=[3], dtype="int32", data=[1, 0, 1])
fm.sample_col(0, 0, 3, mtex, 0.0, 1.0, mask=msk)   # k=1 masked -> stays 99
print('mask: ' + string(int(fm[0,0])) + ' ' + string(int(fm[1,0])) + ' ' + string(int(fm[2,0])))

# --- sample_span: indexed + lut, 2D source ---
var sp = tensor(shape=[2, 5], dtype="uint8")
var flat = tensor(shape=[3, 3], dtype="uint8", data=[0,1,2, 3,4,5, 6,7,8])
sp.sample_span(0, 0, 3, flat, 0.0, 1.0, 1.0, 0.0, lut=lut)  # v=1, u=0,1,2 -> flat 3,4,5 -> 103,104,105
print('span: ' + string(int(sp[0,0])) + ' ' + string(int(sp[0,1])) + ' ' + string(int(sp[0,2])))

# span direct (no lut), diagonal walk with wrap
var sp2 = tensor(shape=[1, 4], dtype="uint8")
sp2.sample_span(0, 0, 4, flat, 0.0, 1.0, 0.0, 1.0)  # (u,v)=(0,0),(1,1),(2,2),(3,3)->wrap(0,0) -> flat 0,4,8,0
print('span diag: ' + string(int(sp2[0,0])) + ' ' + string(int(sp2[0,1])) + ' ' + string(int(sp2[0,2])) + ' ' + string(int(sp2[0,3])))

# --- remap: coordinate gather ---
var src = tensor(shape=[3, 3], dtype="uint8", data=[0,1,2, 10,11,12, 20,21,22])
var dst = tensor(shape=[2, 2], dtype="uint8")
var umap = tensor(shape=[2, 2], dtype="float64", data=[0.0, 2.0, 1.0, 2.0])
var vmap = tensor(shape=[2, 2], dtype="float64", data=[0.0, 0.0, 2.0, 1.0])
dst.remap(src, umap, vmap)   # (v,u): (0,0)=0 (0,2)=2 (2,1)=21 (1,2)=12
print('remap: ' + string(int(dst[0,0])) + ' ' + string(int(dst[0,1])) + ' ' + string(int(dst[1,0])) + ' ' + string(int(dst[1,1])))

# remap clamp vs skip
var d2 = tensor(shape=[1, 2], dtype="uint8")
var um = tensor(shape=[1, 2], dtype="float64", data=[-5.0, 99.0])
var vm = tensor(shape=[1, 2], dtype="float64", data=[0.0, 0.0])
d2.remap(src, um, vm)   # clamp: -5->0, 99->2
print('remap clamp: ' + string(int(d2[0,0])) + ' ' + string(int(d2[0,1])))
var d3 = tensor(shape=[1, 2], dtype="uint8")
d3.fill(77)
d3.remap(src, um, vm, clamp=false)   # out of range -> untouched
print('remap skip: ' + string(int(d3[0,0])) + ' ' + string(int(d3[0,1])))

# remap indexed + lut, color source
var csrc = tensor(shape=[2, 2, 3], dtype="uint8", data=[1,1,1, 2,2,2, 3,3,3, 4,4,4])
var cdst = tensor(shape=[1, 2, 3], dtype="uint8")
var cum = tensor(shape=[1, 2], dtype="float64", data=[0.0, 1.0])
var cvm = tensor(shape=[1, 2], dtype="float64", data=[1.0, 0.0])
cdst.remap(csrc, cum, cvm)   # (v,u)=(1,0)->row2=[3,3,3], (0,1)->row1=[2,2,2]
print('remap rgb: ' + string(int(cdst[0,0,0])) + ' ' + string(int(cdst[0,1,0])))
