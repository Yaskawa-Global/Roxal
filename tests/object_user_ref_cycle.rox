// deliberately create a cycle of object references that reference-counting can't clean up (only a GC can)

// Conservative stack scanning can transiently retain a
// dropped cycle through a stale operand slot in the live interpreter
// dispatch frame; the churn+gc loop re-executes the same opcode mix
// (construct + property store + weakref + nil) to overwrite those slots.
// Under precise-roots configurations the first gc() collects everything
// and the loop exits immediately -- printed output is identical.

type A object:
  var a :A

a1 = A()
a2 = A()

a1.a = a2
a2.a = a1

w1 = _weakref(a1)
w2 = _weakref(a2)

a1 = nil
a2 = nil


// A more challenging one:

a3 = A()
a4 = A()
a5 = A()

a3.a = a4
a4.a = a5
a5.a = a3

w3 = _weakref(a3)
w4 = _weakref(a4)
w5 = _weakref(a5)

a3 = nil
a4 = nil
a5 = nil

print(_weak_alive(w1))
print(_weak_alive(w2))
print(_weak_alive(w3))
print(_weak_alive(w4))
print(_weak_alive(w5))

gc()

rounds = 0
while (_weak_alive(w1) or _weak_alive(w2) or _weak_alive(w3) or _weak_alive(w4) or _weak_alive(w5)) and rounds < 10:
    c1 = A()
    c2 = A()
    c1.a = c2
    c2.a = c1
    cw = _weakref(c1)
    c1 = nil
    c2 = nil
    gc()
    rounds = rounds + 1

print(_weak_alive(w1))
print(_weak_alive(w2))
print(_weak_alive(w3))
print(_weak_alive(w4))
print(_weak_alive(w5))
