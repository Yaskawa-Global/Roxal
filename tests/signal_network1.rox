
var c = clock(10)

var v :vector = [1 2 3 4 5 6]

// split a vector into its elements — a 6-output dataflow node
// (the declared '-> [T,...]' multi-return gives the node 6 output signals)
func split(v :vector) -> [real,real,real,real,real,real]:
  var l :list
  for e in v:
    l.append(e)
  return l

// join values back into a vector (6-input node)
func join(e0: real, e1:real, e2:real, e3:real, e4:real, e5:real) -> vector:
  return vector([e0,e1,e2,e3,e4,e5])

func addToElt0(v :vector, i: int) -> vector:
  var newV = vector(v)  // Create a copy to avoid in-place modification
  newV[0] = newV[0] + i
  return newV

[out0, out1, out2, out3, out4, out5] = split(addToElt0(v,c))

// the bundle of six signals wired into one vector signal
out = join(out0, out1, out2, out3, out4, out5)

print(typeof(out0)) // signal
print(typeof(out))  // signal

c.tick()
wait(us=110000)
print(real(out0))
print(vector(out))

c.tick()
wait(us=110000)
print(vector(out))

c.tick()
wait(us=110000)
print(vector(out))
