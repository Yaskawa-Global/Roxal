  _

@cfunc(lib=mylib, cname='cstrlen_sz', args='const char* s', ret='size_t')
func slen(s: str) -> int:
  _

print(add64(4000000000, 4000000000))
print(add64(-5000000000, 1))
print(mulu64(3000000000, 3))
print(slen('hello roxal'))
