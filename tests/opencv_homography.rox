import opencv.*
import math.*

var src = tensor([8, 2], [0.0,0.0, 100.0,0.0, 0.0,100.0, 100.0,100.0, 50.0,20.0, 20.0,60.0, 80.0,80.0, 60.0,40.0], dtype='float32')
var dst = tensor([8, 2], dtype='float32')
for i in range(0 ..< 8):
  var x = src[i, 0]
  var y = src[i, 1]
  var wq = 0.001 * x + 0.0005 * y + 1.0
  dst[i, 0] = (1.1 * x + 0.1 * y + 5.0) / wq
  dst[i, 1] = (-0.05 * x + 0.95 * y + 10.0) / wq
var hm = find_homography(src, dst)
print(hm.shape())
print(fabs(hm[0, 0] - 1.1) < 0.01)
print(fabs(hm[0, 2] - 5.0) < 0.1)
print(fabs(hm[2, 0] - 0.001) < 0.0001)
print(fabs(hm[2, 2] - 1.0) < 0.01)

var adst = tensor([8, 2], dtype='float32')
for i in range(0 ..< 8):
  adst[i, 0] = 0.9 * src[i, 0] - 0.2 * src[i, 1] + 3.0
  adst[i, 1] = 0.15 * src[i, 0] + 1.05 * src[i, 1] - 7.0
var am = estimate_affine(src, adst)
print(am.shape())
print(fabs(am[0, 0] - 0.9) < 0.001)
print(fabs(am[0, 1] + 0.2) < 0.001)
print(fabs(am[1, 0] - 0.15) < 0.001)
print(fabs(am[1, 2] + 7.0) < 0.01)
