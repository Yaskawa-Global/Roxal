import opencv.*
import math.*

var a = tensor([120, 160, 3], dtype='uint8')
circle(a, 40, 30, 12, [255, 100, 40], -1)
circle(a, 100, 70, 9, [40, 255, 120], -1)
circle(a, 70, 95, 15, [120, 40, 255], -1)
rectangle(a, 115, 20, 30, 25, [255, 255, 0], -1)
rectangle(a, 20, 70, 22, 30, [0, 200, 255], -1)
line(a, 10, 10, 150, 110, [200, 200, 200], 3)
var b = tensor([120, 160, 3], dtype='uint8')
b[0:120, 6:160, 0:3] = a[0:120, 0:154, 0:3]

var fa = orb_detect(a)
var fb = orb_detect(b)
print(fa.points.shape()[0] > 20)
print(fa.descriptors.shape()[1])
var ms = match_features(fa, fb)
var m = ms.pairs.shape()[0]
print(m > 10)
var sum_dx = 0.0
for i in range(0 ..< m):
  sum_dx = sum_dx + (fb.points[int(ms.pairs[i, 1]), 0] - fa.points[int(ms.pairs[i, 0]), 0])
print(fabs(sum_dx / m - 6.0) < 1.0)

# stereo: right = left shifted left by 8 -> disparity ~= 8
var lg = grayscale(a)
var rg = tensor([120, 160, 1], dtype='uint8')
rg[0:120, 0:152, 0:1] = lg[0:120, 8:160, 0:1]
var disp = disparity(lg, rg, 32, 9)
print(disp.shape())
print(fabs(disp[60, 70, 0] - 8.0) < 2.0)
