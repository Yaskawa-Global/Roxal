import RosImage
import dds

# Item 3: create_topic now accepts an optional qos dict.
p = dds.create_participant()
t = dds.create_topic(p, "NestedImageTopic", RosImage.msg.dds_.Image_, {"reliability": "reliable"})
w = dds.create_writer(p, t)
r = dds.create_reader(p, t)

# Item 2: build the message via the REAL nested-module path.
m = RosImage.msg.dds_.Image_()
m.width = 640
m.height = 480
m.encoding = "rgb8"
m.is_bigendian = 0
m.step = 1920
m.data = [1, 2, 3, 4]
var meta = RosImage.msg.dds_.Meta_()
meta.frame_id = "cam"
var stamp = RosImage.msg.dds_.Stamp_()
stamp.sec = 7
stamp.nanosec = 42
meta.stamp = stamp
m.meta = meta

wait(for=dds.write(w, m))
var recv = dds.read(r)

# Item 1: nested struct fields (Meta_/Stamp_) resolve + deserialize.
print("dims {recv.width}x{recv.height} {recv.encoding} step {recv.step}")
print("meta {recv.meta.frame_id} {recv.meta.stamp.sec} {recv.meta.stamp.nanosec}")
print("data {recv.data}")
print("bigendian {recv.is_bigendian}")

# Item 2: non-colliding flat short-name alias still works.
var m2 = RosImage.Image_()
print("alias_ok {m2.width}")

# Item 4: ROS name-mangling helpers (pure, deterministic).
print("topic {dds.ros_topic('/image_raw')}")
print("type {dds.ros_type_name('sensor_msgs/msg/Image')}")
