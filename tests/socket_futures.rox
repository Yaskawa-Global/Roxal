// The socket module's futures -- accept, connect, recv -- resolve on its own
// I/O thread, and allof() over them hears each one.
import socket

var server = socket.tcp()
server.setsockopt("reuseaddr", true)
server.bind("127.0.0.1", 0)
server.listen(1)
[host, port] = server.getsockname()

var client = socket.tcp()
var both = wait(for=allof(server.accept(), client.connect("127.0.0.1", port)))
print(both[1])
var conn = both[0][0]
print(conn is nil)

var reply = conn.recv(16)
client.send("hello")
print(wait(for=reply))

client.close()
conn.close()
server.close()
print("PASS")
