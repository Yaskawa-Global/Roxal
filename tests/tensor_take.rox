# tensor.take(indices) — gather rows along axis 0 (LUT/palette mapping) — plus
# elementwise `rem` on tensors and fill(). These are the bulk ops that let
# per-pixel work (palette maps, class-id -> color, texture lookups) run as one
# C++ operation instead of a per-element Roxal loop.

# take with a [N, C] table: palette mapping
var pal = tensor(shape=[4, 3], dtype="uint8", data=[
  10, 11, 12,   20, 21, 22,   30, 31, 32,   40, 41, 42])
var idx = tensor(shape=[2, 2], dtype="int32", data=[3, 0, 1, 2])
var img = pal.take(idx)
print(img.shape())
print(img.dtype())
print("{img[0, 0, 0]} {img[0, 0, 1]} {img[0, 0, 2]}")
print("{img[0, 1, 0]} {img[1, 0, 1]} {img[1, 1, 2]}")

# take with a 1D table: plain value lookup, result has the indices' shape
var lut = tensor(shape=[5], dtype="float32", data=[0.0, 0.5, 1.0, 1.5, 2.0])
var sel = tensor(shape=[3], dtype="uint8", data=[4, 0, 2])
var vals = lut.take(sel)
print(vals.shape())
print("{vals[0]} {vals[1]} {vals[2]}")

# elementwise rem: tensor rem scalar (sign of dividend, like scalar rem)
var m = tensor(shape=[2, 2], dtype="int32", data=[300, 5, 256, -3])
var w = m rem 256
print("{w[0, 0]} {w[0, 1]} {w[1, 0]} {w[1, 1]}")
print(w.dtype())

# tensor rem tensor
var a = tensor(shape=[3], dtype="int64", data=[10, 11, 12])
var b = tensor(shape=[3], dtype="int64", data=[3, 4, 12])
var c = a rem b
print("{c[0]} {c[1]} {c[2]}")

# fill: in-place, keeps dtype/shape
var f = tensor(shape=[2, 3], dtype="uint8")
f.fill(7)
print("{f[0, 0]} {f[1, 2]}")
f.fill(0)
print("{f[0, 0]} {f[1, 2]}")
var g = tensor(shape=[2], dtype="float64")
g.fill(1.5)
print("{g[0]} {g[1]}")

# the composed framebuffer idiom: shift + wrap + palette-map
var pattern = tensor(shape=[2, 2], dtype="int32", data=[0, 1, 2, 3])
var frame = pal.take((pattern + 2) rem 4)
print("{frame[0, 0, 0]} {frame[0, 1, 0]} {frame[1, 0, 0]} {frame[1, 1, 0]}")
