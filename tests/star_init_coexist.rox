type Point object:
  var x :int = 0
  var y :int = 0

  proc init(*):
    print("star")

  proc init(s :string):
    var parts = s.split(",")
    this.x = int(parts[0])
    this.y = int(parts[1])
    print("string")

var a = Point(3, 4)
print(a.x)
print(a.y)

var b = Point("10,20")
print(b.x)
print(b.y)

var c = Point(y=7)
print(c.x)
print(c.y)
