type GcLogger actor:
  private var log: string = ""

  proc append(msg: string):
    wait(ms=120)
    this.log = this.log + msg

  func getLog() -> string:
    return this.log

type GcWorker actor:
  proc run(logger: mutable GcLogger):
    # Collect on the compute server while the call back to the client is live.
    var appendDone = logger.append("remote:")
    gc()
    wait(for=appendDone)

var logger = GcLogger()
var worker = GcWorker() at "__COMPUTE_TEST_ADDR__"

wait(for=worker.run(logger))

var result = logger.getLog()
wait(for=result)
print(result)
