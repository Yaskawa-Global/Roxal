import opencv.*

var img = tensor([32, 32, 3], dtype='uint8')
img[8:24, 8:24, 0:3] = 255

var big = resize(img, 64, 64, Interpolation.Nearest)
print(big.shape())
print(big[32, 32, 0])
print(big[0, 0, 0])

var small = resize(img, 16, 16)
print(small.shape())

var g = grayscale(img)
print(g.shape())
print(g[16, 16, 0])
print(g[0, 0, 0])

var b = gaussian_blur(g, 5, 1.0)
print(b.shape())
print(b[16, 16, 0])

var e = canny(g, 50.0, 150.0)
print(e.shape())
print(e[7, 12, 0] > 0 or e[8, 12, 0] > 0 or e[9, 12, 0] > 0)

var th = threshold(g, 128.0)
print(th[16, 16, 0])
print(th[0, 0, 0])

var to = threshold_otsu(g)
print(to[16, 16, 0])
