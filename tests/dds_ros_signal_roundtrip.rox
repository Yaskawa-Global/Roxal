@ros
import Image
import dds
import sys

# ros_writer_signal/ros_reader_signal map the ROS topic name (/x -> rt/x).
# A plain reader on the mangled DDS topic name proves the mapping; a reader
# signal on the ROS name receives the same sample.

p = dds.create_participant()
t = dds.create_topic(p, 'rt/sigprobe', sensor_msgs.msg.dds_.Image_)
r = dds.create_reader(p, t)

var got_evt = 0
rsig = dds.ros_reader_signal('/sigprobe', sensor_msgs.msg.dds_.Image_)
when rsig changes as evt:
  got_evt = evt.value.width

wsig = dds.ros_writer_signal('/sigprobe', sensor_msgs.msg.dds_.Image_)
var img = sensor_msgs.msg.Image()
img.width = 4
img.height = 1
img.encoding = "mono8"
img.is_bigendian = 0
img.step = 4
img.data = [1, 2, 3, 4]
var hdr = std_msgs.msg.dds_.Header_()
hdr.frame_id = "sig"
var stamp = builtin_interfaces.msg.dds_.Time_()
stamp.sec = 1
stamp.nanosec = 2
hdr.stamp = stamp
img.header = hdr
wsig.set(img)

var recv = nil
var tries = 0
while recv == nil and tries < 400:
  recv = dds.read(r)
  sys.wait(5ms)
  tries = tries + 1
print("plain {recv.width}x{recv.height} {recv.header.frame_id} data {recv.data}")

var tries2 = 0
while got_evt == 0 and tries2 < 400:
  sys.wait(5ms)
  tries2 = tries2 + 1
print("rsig width {got_evt}")
