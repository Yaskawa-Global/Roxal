# A lifted multi-output predict on an EVENT-DRIVEN island whose inference
# fails ends the run as any node whose body raises does: reported as an
# uncaught exception, never published as a value.  It used to arrive as nil,
# fail the split across the two ports and stop the engine thread, then corrupt
# the heap at exit through the node record left pending.
# shift-const3.onnx: plus = x + c, minus = x - c, c = [1, 2, 3], x of dynamic
# length N -- an N of 1 or 3 runs, any other N fails in the run.
import ai.nn

var model = ai.nn.Model("../modules/ai/shift-const3.onnx", device='cpu', warmup=false)

var x = signal(0, tensor(3, dtype='float32'))     # event-driven: no clock
var [plus, minus] = model.predict(x)
wait(ms=300)
print(plus.value[2])
print(minus.value[2])

x.set(tensor(4, dtype='float32'))
wait(ms=300)
print('not reached')
