
type E event

type MyActor actor:

  proc setup():
    when E occurs:
      print('e handled in MyActor')


type MyOtherActor actor:

  proc setup():
    when E occurs:
      wait(us=20000) // avoid colliding prints
      print('e handled in MyOtherActor')


  


a = MyActor()
oa = MyOtherActor()

a.setup()
oa.setup()

wait(us=10000)

emit E() // should trigger both handlers

wait(us=1000)

a = nil
oa = nil

# Actor teardown is asynchronous (retire queue -> collector -> lifecycle
# join); gc() is the deterministic fence: collected, reclaimed, AND actor
# workers joined/unsubscribed before the next emit.
gc()

emit E() // should trigger none
