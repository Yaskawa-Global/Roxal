
const Freq = 2

type Button object:

  var clicked :signal = signal(Freq,false)

  func onClicked(callback) -> Button:
    when clicked changes:
      callback(this)
    return this

  func clickTest():
    clicked.set(true)


func handleClicked(button):
  print("button clicked now="+button.clicked)

b = Button()
b.onClicked(handleClicked)

b.clickTest()

# the 2 Hz signal publishes the write at its next boundary: up to 500 ms away
wait(ms=700)
