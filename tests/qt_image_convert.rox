// Image bridging: uint8 [H, W, C] tensors round-trip through QML as QImage —
// via a JS function (QJSValue path) and a property var (QVariant path).
// C = 1/3/4; widths chosen so tight tensor rows differ from QImage's 4-byte
// aligned scanlines. Run headless via QT_QPA_PLATFORM=offscreen.
import qt

var e = qt.Engine()
e.load_string('import QtQuick\nimport QtQuick.Window\nWindow { objectName: "win"; Item { objectName: "panel"; property var img; function echo(x) { return x } } }')
var panel = e.find("panel")

# RGB [2, 3, 3] — tight row stride 9 vs QImage scanline stride 12
var rgb = tensor(shape=[2, 3, 3], dtype="uint8", data=[
  10, 20, 30,    40, 50, 60,    70, 80, 90,
  110, 120, 130, 140, 150, 160, 170, 180, 190])
var back = panel.echo(rgb)
print(back.shape())
print(back.dtype())
print(back == rgb)
print(back[1, 2, 2])

# grayscale [2, 2, 1] — tight row stride 2 vs 4
var gray = tensor(shape=[2, 2, 1], dtype="uint8", data=[0, 85, 170, 255])
print(panel.echo(gray) == gray)

# RGBA [1, 2, 4] — alpha channel preserved
var rgba = tensor(shape=[1, 2, 4], dtype="uint8", data=[255, 0, 0, 128, 0, 255, 0, 64])
print(panel.echo(rgba) == rgba)

# property var write/read (QVariant property path rather than JS-function path)
panel.img = rgb
var back2 = panel.img
print(back2 == rgb)
print(back2.shape())
