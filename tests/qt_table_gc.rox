// A table model's rows survive a GC cycle. After append, only the C++ model holds the row
// list (and its row objects); the model hub's external root provider (visitRoots tracing the
// rows + row type) must keep them alive, or the reads below would fail.
import qt

type Task object:
  var name :string
  var qty  :int

var m = qt.TableModel(Task, [["name", "Task"], "qty"])
m.append(Task("Alpha", 1))
m.append(Task("Beta", 2))

# Churn the heap, then force collections. The rows are unreachable from any Roxal root.
var i = 0
while i < 5000:
  var tmp = [i, i + 1, i + 2]
  i = i + 1
gc()
gc()

print(m.count())        # 2
print(m.row(0).name)    # Alpha
print(m.row(1).qty)     # 2
