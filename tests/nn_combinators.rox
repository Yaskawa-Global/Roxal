# allof()/anyof() over futures a native module resolves on its own thread
# (an ai.nn model's predict, run by the model's worker): the combinator hears
# each future resolve.  It used to wait forever for any still in flight.
import ai.nn

var m = ai.nn.Model("../modules/ai/scale-shift.onnx", device='cpu', outputs=['doubled'])
var x = tensor(1, 4, dtype='float32')
x[0, 3] = 4.0
var y = tensor(1, 4, dtype='float32')
y[0, 3] = 1.0

var allOk = true
var anyOk = true
for i in range(0..<20):
    var both = wait(for=allof(m.predict(x), m.predict(y)))
    allOk = allOk and both[0][0, 3] == 8.0 and both[1][0, 3] == 2.0
    var first = wait(for=anyof(m.predict(x), m.predict(x)))
    anyOk = anyOk and first['value'][0, 3] == 8.0
print(allOk)
print(anyOk)
