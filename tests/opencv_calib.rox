import opencv.*
import math.*

var cam = tensor([3, 3], [500.0, 0.0, 160.0,  0.0, 500.0, 120.0,  0.0, 0.0, 1.0])
var obj = tensor([6, 3], [0.0,0.0,0.0, 2.0,0.0,0.0, 0.0,2.0,0.0, 2.0,2.0,0.0, 1.0,1.0,1.0, 2.0,1.0,0.5], dtype='float32')
var true_pose = Pose(tensor([3], [0.1, -0.2, 0.05]), tensor([3], [0.5, -0.3, 8.0]))
var proj = project_points(obj, true_pose, cam)
print(proj.shape())
var solved = solve_pnp(obj, proj, cam)
print(fabs(solved.tvec[2] - 8.0) < 0.01)
print(fabs(solved.rvec[0] - 0.1) < 0.001)

var grid = tensor([20, 3], dtype='float32')
for gy in range(0 ..< 4):
  for gx in range(0 ..< 5):
    grid[gy * 5 + gx, 0] = real(gx)
    grid[gy * 5 + gx, 1] = real(gy)
    grid[gy * 5 + gx, 2] = 0.0
var poses = [Pose(tensor([3], [0.0, 0.0, 0.0]), tensor([3], [-2.0, -1.5, 10.0])),
             Pose(tensor([3], [0.3, 0.1, 0.0]), tensor([3], [-1.0, -2.0, 12.0])),
             Pose(tensor([3], [-0.2, 0.3, 0.1]), tensor([3], [-2.5, -1.0, 9.0])),
             Pose(tensor([3], [0.1, -0.3, -0.1]), tensor([3], [-1.5, -1.8, 11.0]))]
var objs = []
var imgs = []
for p in poses:
  objs.append(grid)
  imgs.append(project_points(grid, p, cam))
var calib = calibrate_camera(objs, imgs, 320, 240)
print(calib.error < 0.1)
print(fabs(calib.camera_matrix[0, 0] - 500.0) < 1.0)
print(fabs(calib.camera_matrix[1, 1] - 500.0) < 1.0)
print(fabs(calib.camera_matrix[0, 2] - 160.0) < 1.0)
print(fabs(calib.camera_matrix[1, 2] - 120.0) < 1.0)
print(fabs(calib.dist_coeffs[0]) < 0.01)

var scene = tensor([64, 64, 3], dtype='uint8')
scene[20:44, 20:44, 1] = 255
var und = undistort(scene, cam, calib.dist_coeffs)
print(und.shape())
