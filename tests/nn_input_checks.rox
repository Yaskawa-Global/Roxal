# predict checks its inputs against the model before any inference starts,
# so each mistake raises at the call (catchable) rather than failing inside
# the run.  The dtype and input-name checks are new: a wrong dtype used to
# reach ONNX Runtime, and an unknown dict key was silently ignored.
# add-sub.onnx: inputs a, b [1, 3]; scale-shift.onnx: input x [1, 4]; all float32.
import ai.nn

var addsub = ai.nn.Model("../modules/ai/add-sub.onnx", device='cpu')
var scale = ai.nn.Model("../modules/ai/scale-shift.onnx", device='cpu')
var a = tensor(1, 3, dtype='float32')
var b = tensor(1, 3, dtype='float32')

func rejects(m, arg, expected :string) -> bool:
    try:
        var r = m.predict(arg)
        return r is nil
    except e:
        if expected in string(e):
            return true
        print(e)
        return false

print(rejects(scale, tensor(1, 4, dtype='float64'), "dtype mismatch for input 'x'"))
print(rejects(scale, tensor(1, 5, dtype='float32'), "shape mismatch for input 'x'"))
print(rejects(addsub, {'a': a, 'c': b}, "has no input 'c'"))
print(rejects(addsub, {'a': a}, "missing input 'b'"))
print(rejects(addsub, a, "the model has 2 inputs"))
print(rejects(addsub, [a], "predict list has 1 elements"))
print(rejects(addsub, {'a': a, 'b': 5}, "input 'b' is not a tensor"))

# and well-formed calls still run, by name in any order or by position
a[0, 0] = 10.0
b[0, 0] = 1.0
print(addsub.predict({'b': b, 'a': a})[0][0, 0])
print(addsub.predict([a, b])[1][0, 0])
print('done')
