// dfdoc: a document built purely from edit ops compiles and its network
// actually runs (bounded boolean check, tolerant of machine load)
import dfdoc
import inspect

var doc = dfdoc.new_document('Cosine', [{'name': 'freq', 'default': 50.0}])['doc']
var w = dfdoc.apply(doc, {'op': 'add_node', 'kind': 'signal', 'label': 'w', 'clock': 'freq', 'init': 0.0, 'x': 0, 'y': 0})['id']
var f = dfdoc.apply(doc, {'op': 'add_node', 'kind': 'func', 'callee': 'math.cos', 'nin': 1, 'x': 1, 'y': 0})['id']
var o = dfdoc.apply(doc, {'op': 'add_node', 'kind': 'output', 'name': 'out', 'x': 2, 'y': 0})['id']
dfdoc.apply(doc, {'op': 'connect', 'from': {'id': w, 'port': 0}, 'to': {'id': f, 'port': 0}, 'prev': true})
dfdoc.apply(doc, {'op': 'connect', 'from': {'id': f, 'port': 0}, 'to': {'id': w, 'port': 0}})
dfdoc.apply(doc, {'op': 'connect', 'from': {'id': f, 'port': 0}, 'to': {'id': o, 'port': 0}})

var runner = dfdoc.save(doc) + """
var __c = Cosine()
var __n = 0
when __c.out changes:
  __n = __n + 1
wait(ms=600)
print('ran: ' + string(__n >= 5))
"""
inspect.compile(inspect.parse(runner, 'runner'), 'runner')()
