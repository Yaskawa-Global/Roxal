import opencv.*
import math.*

var img = tensor([8, 8, 3], dtype='uint8')
img[0:8, 0:8, 0] = 255
img[2, 3, 1] = 128
var blob = to_blob(img, 8, 8)
print(blob.shape())
print(blob[0, 0, 4, 4])
print(fabs(blob[0, 1, 2, 3] - 0.501960784) < 0.001)
print(blob[0, 2, 4, 4])

# resize path + imagenet-style normalization
var blob2 = to_blob(img, 4, 4, 0.003921568627451, [0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
print(blob2.shape())
print(fabs(blob2[0, 0, 0, 0] - (1.0 - 0.485) / 0.229) < 0.001)
