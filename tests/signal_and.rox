// 'and' with a signal operand lifts into a dataflow node (it cannot
// short-circuit on a value that changes over time); with plain values it
// keeps its ordinary short-circuit semantics.

var c = clock(10)
even = (c rem 2) == 0
big = c > 2
a = even and big
print(typeof(a))

var i = 0
while i < 5:
  c.tick()
  wait(us=120000)
  print("c={int(c)} even={bool(even)} big={bool(big)} and={bool(a)}")
  i = i + 1

// a falsey scalar LHS still short-circuits: no node, no dependency
var sc = false and even
print(typeof(sc))
print(sc)

// a truthy scalar LHS yields the signal RHS, so the result stays live
var live = true and even
print(typeof(live))
wait(us=250000)   // let the new node join the island's tick cycle
print(bool(live) == bool(even))
