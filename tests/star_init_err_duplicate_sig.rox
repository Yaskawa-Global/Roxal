// init(*) expands at compile time to a concrete signature; declaring an
// explicit init with the same expanded signature is a duplicate-signature
// error from defineMethod.

type Point object:
  var x :int = 0
  var y :int = 0

  proc init(*):
    print("star")

  proc init(x :int, y :int):
    this.x = x
    this.y = y

var p = Point(1, 2)
print(p.x)
