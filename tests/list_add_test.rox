// Test list + operator (list-only concatenation) and the mutator methods.

// list + list concatenation (returns a new list)
var list1 = [1, 2, 3]
var list2 = [4, 5, 6]
var concat = list1 + list2
print("List concatenation: " + concat)

// append adds a single element (a list is added as ONE nested element)
var list3 = [1, 2, 3]
list3.append(4)
print("After append: " + list3)
list3.append([5, 6])
print("After append list: " + list3)

// extend adds each element of another list
var list4 = [1, 2]
list4.extend([3, 4])
print("After extend: " + list4)

// list + [x] concatenates a single element without mutating the operands
var list5 = [1, 2]
var added = list5 + ["hello"]
print("Plus singleton: " + added)

// Verify + operands unchanged (by-value semantics)
print("Original list1: " + list1)
print("Original list2: " + list2)
print("Original list5: " + list5)
