# Against a real Triton server (runtests --triton-url HOST:PORT, serving the
# repository scripts/triton-test-repo.sh builds): the small ai.nn test
# models give the same results served as run in this process -- whatever
# order the server lists their outputs in, outputs= binds them by name -- and
# a run the model itself refuses raises.
import ai.nn

# scale-shift.onnx: doubled = x * 2, plus_one = x + 1, shape [1, 4]
var scale = ai.nn.Model("triton://__TRITON_ADDR__/scale_shift", outputs=['doubled', 'plus_one'])
var x = tensor(1, 4, dtype='float32')
x[0, 3] = 4.0
var res = scale.predict(x)
print(res[0][0, 3])
print(res[1][0, 3])
var served = ai.nn.Model("triton://__TRITON_ADDR__/scale_shift")
print(len(served.outputs()))

# add-sub.onnx: inputs a, b [1, 3]; outputs sum_out, diff_out
var addsub = ai.nn.Model("triton://__TRITON_ADDR__/add_sub", outputs=['sum_out', 'diff_out'])
var a = tensor(1, 3, dtype='float32')
var b = tensor(1, 3, dtype='float32')
a[0, 0] = 10.0
b[0, 0] = 1.0
var r = addsub.predict({'b': b, 'a': a})
print(r[0][0, 0])
print(r[1][0, 0])

var sig = signal(0, x)
var [d, p] = scale.predict(sig)
wait(ms=500)
print(d.value[0, 3])
print(p.value[0, 3])

# shift-const3.onnx: x of dynamic length N, run fails unless N is 1 or 3
var shift = ai.nn.Model("triton://__TRITON_ADDR__/shift_const3", outputs=['plus'])
print(shift.predict(tensor(3, dtype='float32'))[2])
try:
    var y = shift.predict(tensor(4, dtype='float32'))
    print(y is nil)
except e :RuntimeException:
    print("[INTERNAL]" in string(e))
# The server's own description: NVIDIA's names itself 'triton' and lists the
# model_repository extension; any version.
var info = ai.nn.server_info("__TRITON_ADDR__")
print(info['kind'] + ' ' + info['name'])
print(len(info['version']) > 0)
print('model_repository' in info['extensions'])
print(scale.server_info()['version'] == info['version'])
print('done')
