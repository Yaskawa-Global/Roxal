// A uint8 tensor with an unsupported channel count can't become an image.
// Headless via QT_QPA_PLATFORM=offscreen.
import qt

var e = qt.Engine()
e.load_string('import QtQuick\nimport QtQuick.Window\nimport Roxal\nWindow { FrameView { objectName: "fb" } }')
var fb = e.find("fb")
fb.present(tensor(shape=[4, 4, 2], dtype="uint8"))   # 2 channels: not 1/3/4
