print('before:')
print(_df_graph())


func createSignals():

  var s = signal(10,1.0)
  var c = clock(10)
 
  var sum = s + c
  
  var add1 = sum + 1

  c.run()
  wait(ms=110)


createSignals()

# Destruction is promptly QUEUED to the collector, not scope-tied: gc() is
# the deterministic collect-and-reclaim fence guaranteeing the signals
# created above are torn down before the graph is inspected.
gc()

print('after:')
print(_df_graph())

