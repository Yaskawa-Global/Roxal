// A signal is never const: it exists to change over time, and whether it can
// be written is decided by the signal itself (only an undriven source can be
// set or wired).  So `const` on a signal-typed name, variable type or
// parameter only means the name can't be rebound; every signal operation
// works through it, and through a const container.
const s :signal = signal(10, 0, "s")
var t :const signal = signal(10, 0, "t")
const u = signal(10, 0, "u")
s.set(1)
t.set(2)
u.set(3)
print("{s.value} {t.value} {u.value}")

func bump(sig :const signal, v :int):
  sig.set(v)
bump(s, 11)
print(s.value)

const d = {"x": s}
d.x.set(12)
print("{s.value} {d.x is s}")

type Holder object:
  var sig :signal = nil
const h = Holder(sig=t)
h.sig.set(22)
print("{t.value} {h.sig is t}")
