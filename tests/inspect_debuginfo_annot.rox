# Statement boundaries (what breakpoints bind to) of annotated declarations and
# statements are on the construct's own line, not on its annotation lines.
import inspect.*

func g(a:int) -> int:
  @act(x=1)
  var x = a + 1
  @act(x=2)
  @more
  x = x * 2
  @loop
  while x > 100:
    x = x - 1
  return x

var lines = []
for s in debug_info(g)['stmts']:
  if not (s['line'] in lines):
    lines.append(s['line'])
print(lines)
