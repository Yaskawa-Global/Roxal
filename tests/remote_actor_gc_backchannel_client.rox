type ClientGcLogger actor:
  private var log: string = ""

  proc append(msg: string):
    wait(ms=120)
    this.log = this.log + msg

  func getLog() -> string:
    return this.log

type ClientGcWorker actor:
  proc run(logger: mutable ClientGcLogger):
    wait(for=logger.append("remote:"))

func runTest():
  var logger = ClientGcLogger()
  var worker = ClientGcWorker() at "__COMPUTE_TEST_ADDR__"

  var remoteDone = worker.run(logger)
  wait(ms=20)
  gc()
  wait(for=remoteDone)

  var result = logger.getLog()
  wait(for=result)
  print(result)

runTest()
