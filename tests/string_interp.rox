var s = "glad to meet you"
print("Hi, I'm {s}")

s2 = "."

print("{s}{s2}") // 'glad to meet you.'

print('{s}') // {s}

type Item object:
   var name
   proc init(n):
     this.name = n

type Box object:
   var label
   var items
   proc init(label, items):
     this.label = label
     this.items = items
   func describe(index):
     return "Box {this.label} has {this.items[index].name}"

var box = Box("letters", [Item("alpha"), Item("beta"), Item("gamma")])
var idx = 2
var col = 1

print("label={box.label}")
print("first item={box.items[0].name}")
print(box.describe(1))
print("chosen={box.items[idx].name}")
print("literal index={box.items[2].name}")
print("from method={box.describe(0)}")
var metadata = { 'owner': 'clerk', 'tags': { 'primary': 'letters' } }
var mat = matrix([[1, 2, 3], [4, 5, 6]])
var row = 1

print("dict lookup={metadata['tags']['primary']}")
print("matrix direct={mat[1, 0]}")
print("matrix vars={mat[row, col]}")

// A placeholder holds any single-line expression the grammar accepts, so
// the following all work as ordinary Roxal expressions.

var a = 2
var b = 3

// operators and grouping
print("sum={a + b}")
print("group={(a + b) * a}")
print("cmp={a != b} {a < b} {a == 2 and b == 3}")
print("neg={-a} not={not (a == b)}")
print("bits={a | b} {a & b}")

// dotted / computed index, index chains
var keys = Item("owner")
print("dotted index={metadata[keys.name]}")
var nested = [[1, 2], [3, 4]]
print("index chain={nested[0][1]}")

// keyword and defaulted call arguments
func pick(first, second):
  return first

print("kwargs={pick(second=b, first=a)}")

// base-prefixed numerics inside a placeholder
print("hex={0xff} oct={0o17} bin={0b101}")

// Literals as placeholder expressions.  A dict literal needs a space after the
// opening brace: "{{" is the escape for a literal '{', so "{{'k': a}}" is text.
print("list={[a, b]} dict={ {'k': a} }")
print("escaped braces are text: {{'k': a}}")

// a placeholder may call a method on the result of another call
print("chained={box.describe(0)}")

// conversions still apply to non-string parts
print("mixed={a}/{1.5}/{true}/{nil}")
