# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.app

# Roxal bytecode caches
.*.roc

# Build directories
build/
# build-wasm-mt, build-rel, build-lto, build-qt, ...
build-*/
compiler/cpp-gen/
node_modules/

# gui-user MCP smoke-test scratch (screenshots, display logs)
.gui-user/

# 3D mesh assets for the qt examples are .obj files, not compiled objects — keep them
# (the generic *.obj rule above is for build artifacts).
!examples/qt/*.obj
modules/opencv/models/*.onnx
tests/tmp_*
