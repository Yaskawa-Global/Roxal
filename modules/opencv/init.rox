#
# ---- DNN interop + task wrappers ----
#
# The DNN task objects below need ONNX model files: run
# modules/opencv/models/download-models.sh once (default model paths resolve
# next to this module via sys.source_dir(); pass model= to override).

var _models = sys.source_dir() + '/models/'

# Convert an RGB image to an NCHW float32 [1, 3, height, width] input blob for
# DNN inference (e.g. ai.nn Model.predict): resize, then per channel
# (v * scale - mean) / std. Defaults produce 0..1 values.
func to_blob(img: tensor, width: int, height: int, scale: real = 0.003921568627451, mean = nil, std = nil) -> tensor:
  var s = img.shape()
  var m = mean
  if m == nil:
    m = [0.0, 0.0, 0.0]
  var sd = std
  if sd == nil:
    sd = [1.0, 1.0, 1.0]
  var out = tensor([1, 3, height, width], dtype='float32')
  if _to_blob(img, s[0], s[1], s[2], out, height, width, scale,
              m[0], m[1], m[2], sd[0], sd[1], sd[2]) != 0:
    raise RuntimeException('to_blob: ' + _last_error())
  return out

type Face object:
  var box              # [x, y, w, h] ints
  var landmarks        # float32 [5, 2]: right eye, left eye, nose, mouth corners
  var score: real = 0.0

type FaceDetector object:
  var _d

  proc init(model: string = '', score_threshold: real = 0.6, nms_threshold: real = 0.3):
    var path = model
    if path == '':
      path = _models + 'face_detection_yunet_2023mar.onnx'
    _d = _face_new(path, score_threshold, nms_threshold)
    if _d == nil:
      raise RuntimeException('FaceDetector: ' + _last_error())

  # Detect faces; returns a list of Face.
  func detect(img: tensor) -> list:
    var s = img.shape()
    var buf = tensor([64, 15], dtype='float32')
    var n = _face_detect(_d, img, s[0], s[1], s[2], buf, 64)
    if n < 0:
      raise RuntimeException('FaceDetector.detect: ' + _last_error())
    var result = []
    for i in range(0 ..< n):
      var lm = tensor([5, 2], dtype='float32')
      for j in range(0 ..< 5):
        lm[j, 0] = buf[i, 4 + 2 * j]
        lm[j, 1] = buf[i, 5 + 2 * j]
      var box = [int(buf[i, 0]), int(buf[i, 1]), int(buf[i, 2]), int(buf[i, 3])]
      result.append(Face(box, lm, buf[i, 14]))
    return result

# ALIKED learned keypoints/descriptors (drop-in upgrade over orb_detect; match
# its Features with LightGlue, not match_features).
type Aliked object:
  var _a

  proc init(model: string = ''):
    var path = model
    if path == '':
      path = _models + 'aliked-n16rot-top1k-640.onnx'
    _a = _aliked_new(path)
    if _a == nil:
      raise RuntimeException('Aliked: ' + _last_error())

  func detect(img: tensor) -> Features:
    var s = img.shape()
    var f = _aliked_detect(_a, img, s[0], s[1], s[2])
    if f == nil:
      raise RuntimeException('Aliked.detect: ' + _last_error())
    return _features_from(f, s[1], s[0], 'Aliked.detect')

# LightGlue attention-based matcher for ALIKED features.
type LightGlue object:
  var _m

  proc init(model: string = '', score_threshold: real = 0.0):
    var path = model
    if path == '':
      path = _models + 'lightglue_for_aliked.onnx'
    _m = _lightglue_new(path, score_threshold)
    if _m == nil:
      raise RuntimeException('LightGlue: ' + _last_error())

  func match_features(a: Features, b: Features) -> Matches:
    if a.points == nil or b.points == nil:
      return Matches(nil, nil)
    var na = a.points.shape()[0]
    var nb = b.points.shape()[0]
    var pairs = tensor([na, 2], dtype='int32')
    var dists = tensor([na], dtype='float32')
    var n = _lightglue_match(_m, a.points, a.descriptors, na, b.points, b.descriptors, nb,
                             a.descriptors.shape()[1], a.width, a.height, b.width, b.height,
                             pairs, dists)
    if n < 0:
      raise RuntimeException('LightGlue.match: ' + _last_error())
    if n == 0:
      return Matches(nil, nil)
    return Matches(pairs[0:n, 0:2], dists[0:n])

# Single-object tracker (VIT).
type Tracker object:
  var _t
  var score: real = 0.0

  proc init(model: string = ''):
    var path = model
    if path == '':
      path = _models + 'object_tracking_vittrack_2023sep.onnx'
    _t = _tracker_new(path)
    if _t == nil:
      raise RuntimeException('Tracker: ' + _last_error())

  # Start tracking the object inside the given box.
  proc start(img: tensor, x: int, y: int, width: int, height: int):
    var s = img.shape()
    if _tracker_init(_t, img, s[0], s[1], s[2], x, y, width, height) != 0:
      raise RuntimeException('Tracker.start: ' + _last_error())

  # Track into the next frame; returns [x, y, w, h] or nil when lost.
  # The confidence is left in .score either way.
  func update(img: tensor) -> list:
    var s = img.shape()
    var rect = tensor([4], dtype='int32')
    var sc = tensor([1])
    var rc = _tracker_update(_t, img, s[0], s[1], s[2], rect, sc)
    if rc < 0:
      raise RuntimeException('Tracker.update: ' + _last_error())
    score = sc[0]
    if rc == 0:
      return nil
    return [int(rect[0]), int(rect[1]), int(rect[2]), int(rect[3])]


