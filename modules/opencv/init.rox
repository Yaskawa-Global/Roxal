# Median filter; ksize must be odd.
func median_blur(img: tensor, ksize: int) -> tensor:
  var s = img.shape()
  var out = tensor([s[0], s[1], s[2]], dtype='uint8')
  if _gen_median_blur(img, s[0], s[1], s[2], out, ksize) != 0:
    raise RuntimeException('median_blur: ' + _last_error())
  return out

# Box blur.
func blur(img: tensor, ksize: int) -> tensor:
  var s = img.shape()
  var out = tensor([s[0], s[1], s[2]], dtype='uint8')
  if _gen_blur(img, s[0], s[1], s[2], out, ksize) != 0:
    raise RuntimeException('blur: ' + _last_error())
  return out

# Edge-preserving smoothing.
func bilateral_filter(img: tensor, diameter: int, sigma_color: real, sigma_space: real) -> tensor:
  var s = img.shape()
  var out = tensor([s[0], s[1], s[2]], dtype='uint8')
  if _gen_bilateral_filter(img, s[0], s[1], s[2], out, diameter, sigma_color, sigma_space) != 0:
    raise RuntimeException('bilateral_filter: ' + _last_error())
  return out

# Histogram equalization (grayscale).
func equalize_hist(img: tensor) -> tensor:
  var s = img.shape()
  if s[2] != 1:
    raise RuntimeException('equalize_hist: expects a grayscale image (use grayscale() first)')
  var out = tensor([s[0], s[1], s[2]], dtype='uint8')
  if _gen_equalize_hist(img, s[0], s[1], s[2], out) != 0:
    raise RuntimeException('equalize_hist: ' + _last_error())
  return out

# Sobel derivative magnitude (grayscale).
func sobel(img: tensor, dx: int, dy: int, ksize: int = 3) -> tensor:
  var s = img.shape()
  if s[2] != 1:
