  return out

# Laplacian edge response (grayscale).
func laplacian(img: tensor, ksize: int = 3) -> tensor:
  var s = img.shape()
  if s[2] != 1:
    raise RuntimeException('laplacian: expects a grayscale image (use grayscale() first)')
