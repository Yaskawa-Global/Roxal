func erode(img: tensor, ksize: int, iterations: int = 1, kshape = MorphShape.Rect) -> tensor:
  var s = img.shape()
  var out = tensor([s[0], s[1], s[2]], dtype='uint8')
  if _gen_erode(img, s[0], s[1], s[2], out, ksize, iterations, kshape) != 0:
