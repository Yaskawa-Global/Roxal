# OpenCV binding for Roxal — pure Roxal over a thin C shim (libcvxshim.so).
#
# Images are uint8 tensors of shape [height, width, channels] in RGB channel
# order (Roxal's image convention, shared with media.Image and qt.FrameView).
# BGR<->RGB conversion happens inside the shim, at the OpenCV boundary.
#
# The section between the GENERATED markers is produced by shim/generate.py
# from OpenCV's own binding metadata — edit the spec tables there, not the
# section itself.

import sys
cvxlib = sys.loadlib('./libcvxshim.so')


#
# internal shim declarations

@cfunc(lib=cvxlib, cname='cvx_version', ret='const char*')
func _version() -> string:
  _

@cfunc(lib=cvxlib, cname='cvx_last_error', ret='const char*')
func _last_error() -> string:
  _

# This module (including its generated section) is written against OpenCV 5.0;
# fail loudly at import if libcvxshim was built against something else.
if _version()[0:3] != '5.0':
  raise RuntimeException('opencv module expects OpenCV 5.0.x but libcvxshim.so reports ' + _version() + ' — rebuild the shim (modules/opencv/shim/build.sh) against the pinned deps/opencv')

