# destination channel count for each ColorCode (generated from the codes above)
func _cvt_channels(code) -> int:
  if code == ColorCode.Rgb2Rgba:
    return 4
  if code == ColorCode.Rgb2Gray:
    return 1
  if code == ColorCode.Gray2Rgba:
    return 4
  if code == ColorCode.Rgba2Gray:
    return 1
  return 3

