#
# ---- in-memory image codecs ----

# copy a decoded Mat handle into a [H, W, C] uint8 tensor
func _mat_to_image(m, what: string) -> tensor:
  var h = _mat_rows(m)
  var w = _mat_cols(m)
  var c = _mat_channels(m)
  var img = tensor([h, w, c], dtype='uint8')
  if _mat_copy_to(m, img, h * w * c) != 0:
    raise RuntimeException(what + ': ' + _last_error())
  return img

# Encode an image to an in-memory byte stream ('.png', '.jpg', ...) as a [N] uint8 tensor.
func imencode(img: tensor, ext: string = '.png', quality: int = 95) -> tensor:
  var s = img.shape()
  var m = _imencode(ext, img, s[0], s[1], s[2], quality)
  if m == nil:
    raise RuntimeException('imencode: ' + _last_error())
  var n = _mat_cols(m)
  var out = tensor([n], dtype='uint8')
  if _mat_copy_to(m, out, n) != 0:
    raise RuntimeException('imencode: ' + _last_error())
  return out

# Decode an in-memory byte stream to a uint8 [H, W, C] RGB image.
func imdecode(data: tensor, channels: int = 3) -> tensor:
  var s = data.shape()
  var m = _imdecode(data, s[0], channels)
  if m == nil:
    raise RuntimeException('imdecode: ' + _last_error())
  return _mat_to_image(m, 'imdecode')


#
# ---- ArUco markers ----

type Marker object:
  var id: int = 0
  var corners      # float32 [4, 2] pixel corners: TL, TR, BR, BL

# Render a marker image (uint8 [side, side, 1]) suitable for printing/display.
func generate_marker(dictionary, id: int, side: int = 200) -> tensor:
  var out = tensor([side, side, 1], dtype='uint8')
  if _aruco_generate(dictionary, id, side, out) != 0:
    raise RuntimeException('generate_marker: ' + _last_error())
  return out

# detector instances are cached per dictionary (construction loads tables)
var _aruco_detectors = {}

func _aruco_detector(dictionary):
  var key = int(dictionary)
  if key in _aruco_detectors:
    return _aruco_detectors[key]
  var det = _aruco_detector_new(dictionary)
  if det == nil:
    raise RuntimeException('detect_markers: ' + _last_error())
  _aruco_detectors[key] = det
  return det

# Detect markers; returns a list of Marker.
func detect_markers(img: tensor, dictionary = ArucoDict.Dict4x4_50) -> list:
  var s = img.shape()
  var r = _aruco_detect(_aruco_detector(dictionary), img, s[0], s[1], s[2])
  if r == nil:
    raise RuntimeException('detect_markers: ' + _last_error())
  var result = []
  for i in range(0 ..< _aruco_count(r)):
    var corners = tensor([4, 2], dtype='float32')
    var id = _aruco_get(r, i, corners)
    if id < 0:
      raise RuntimeException('detect_markers: ' + _last_error())
    result.append(Marker(id, corners))
  return result

# Draw a detected marker outline and id onto the image (in place).
proc draw_marker(img: tensor, marker: Marker, color = [0, 255, 0], thickness: int = 2):
  var c = marker.corners
  for j in range(0 ..< 4):
    var k = (j + 1) rem 4
    line(img, int(c[j, 0]), int(c[j, 1]), int(c[k, 0]), int(c[k, 1]), color, thickness)
  put_text(img, string(marker.id), int(c[0, 0]), int(c[0, 1]) - 6, color, 0.6)


#
# ---- camera calibration and pose ----

type Pose object:
  var rvec         # float64 [3] Rodrigues rotation vector
  var tvec         # float64 [3] translation

func _ndist(dist_coeffs) -> int:
  if dist_coeffs == nil:
    return 0
  return dist_coeffs.shape()[0]

# Pose from 3D<->2D correspondences: object_points float32 [N, 3],
# image_points float32 [N, 2], camera_matrix float64 [3, 3].
func solve_pnp(object_points: tensor, image_points: tensor, camera_matrix: tensor, dist_coeffs = nil) -> Pose:
  var n = object_points.shape()[0]
  var rvec = tensor([3])
  var tvec = tensor([3])
  if _solve_pnp(object_points, image_points, n, camera_matrix, dist_coeffs, _ndist(dist_coeffs), rvec, tvec) != 0:
    raise RuntimeException('solve_pnp: ' + _last_error())
  return Pose(rvec, tvec)

# Project 3D points (float32 [N, 3]) through a pose; returns float32 [N, 2] pixels.
func project_points(object_points: tensor, pose: Pose, camera_matrix: tensor, dist_coeffs = nil) -> tensor:
  var n = object_points.shape()[0]
  var out = tensor([n, 2], dtype='float32')
  if _project_points(object_points, n, pose.rvec, pose.tvec, camera_matrix, dist_coeffs, _ndist(dist_coeffs), out) != 0:
    raise RuntimeException('project_points: ' + _last_error())
  return out

# Pose of a detected marker whose printed side length is marker_size (any unit;
# tvec comes back in the same unit).
func marker_pose(marker: Marker, marker_size: real, camera_matrix: tensor, dist_coeffs = nil) -> Pose:
  var h = marker_size / 2.0
  var obj = tensor([4, 3], [-h, h, 0.0,  h, h, 0.0,  h, -h, 0.0,  -h, -h, 0.0], dtype='float32')
  return solve_pnp(obj, marker.corners, camera_matrix, dist_coeffs)

# Find inner chessboard corners (cols x rows inner corners); float32 [cols*rows, 2]
# in row-major board order, or nil if the board was not found.
func find_chessboard(img: tensor, cols: int, rows: int) -> tensor:
  var s = img.shape()
  var out = tensor([cols * rows, 2], dtype='float32')
  var rc = _find_chessboard(img, s[0], s[1], s[2], cols, rows, out)
  if rc < 0:
    raise RuntimeException('find_chessboard: ' + _last_error())
  if rc == 0:
    return nil
  return out

type Calibration object:
  var camera_matrix    # float64 [3, 3]
  var dist_coeffs      # float64 [5]
  var error: real = 0.0

# Calibrate from N views: object_points is a list of float32 [Ni, 3] tensors,
# image_points a list of float32 [Ni, 2] tensors (same lengths).
func calibrate_camera(object_points: list, image_points: list, width: int, height: int) -> Calibration:
  var nviews = len(object_points)
  var total = 0
  for v in object_points:
    total = total + v.shape()[0]
  var obj = tensor([total, 3], dtype='float32')
  var imgp = tensor([total, 2], dtype='float32')
  var counts = tensor([nviews], dtype='int32')
  var off = 0
  for i in range(0 ..< nviews):
    var n = object_points[i].shape()[0]
    obj[off:off+n, 0:3] = object_points[i]
    imgp[off:off+n, 0:2] = image_points[i]
    counts[i] = n
    off = off + n
  var cam = tensor([3, 3])
  var dist = tensor([5])
  var err = _calibrate_camera(obj, imgp, counts, nviews, width, height, cam, dist)
  if err < 0.0:
    raise RuntimeException('calibrate_camera: ' + _last_error())
  return Calibration(cam, dist, err)

# Undo lens distortion using calibration results.
func undistort(img: tensor, camera_matrix: tensor, dist_coeffs: tensor) -> tensor:
  var s = img.shape()
  var out = tensor([s[0], s[1], s[2]], dtype='uint8')
  if _undistort(img, s[0], s[1], s[2], out, camera_matrix, dist_coeffs, dist_coeffs.shape()[0]) != 0:
    raise RuntimeException('undistort: ' + _last_error())
  return out

# Hand-eye calibration: gripper_to_base and target_to_cam are equal-length lists
# of float64 [4, 4] transforms; returns the camera->gripper [4, 4] transform.
func hand_eye(gripper_to_base: list, target_to_cam: list, method = HandEyeMethod.Tsai) -> tensor:
  var n = len(gripper_to_base)
  var g2b = tensor([n, 4, 4])
  var t2c = tensor([n, 4, 4])
  for i in range(0 ..< n):
    for r in range(0 ..< 4):
      for c in range(0 ..< 4):
        g2b[i, r, c] = gripper_to_base[i][r, c]
        t2c[i, r, c] = target_to_cam[i][r, c]
  var out = tensor([4, 4])
  if _calibrate_hand_eye(g2b, t2c, n, method, out) != 0:
    raise RuntimeException('hand_eye: ' + _last_error())
  return out


#
# ---- features and matching ----

type Features object:
  var points           # float32 [N, 4]: x, y, size, angle (nil when none found)
  var descriptors      # uint8 [N, 32] (ORB) or float32 [N, 128] (ALIKED); nil when none
  var width: int = 0   # size of the image the features came from
  var height: int = 0

# build a Features result from a shim CvxFeatures handle
func _features_from(f, w: int, h: int, what: string) -> Features:
  var n = _features_count(f)
  if n == 0:
    return Features(nil, nil, w, h)
  var pts = tensor([n, 4], dtype='float32')
  var dt = 'uint8'
  if _features_desc_type(f) == 1:
    dt = 'float32'
  var desc = tensor([n, _features_desc_cols(f)], dtype=dt)
  if _features_keypoints(f, pts) != 0 or _features_descriptors(f, desc) != 0:
    raise RuntimeException(what + ': ' + _last_error())
  return Features(pts, desc, w, h)

# ORB keypoints + descriptors.
func orb_detect(img: tensor, nfeatures: int = 500) -> Features:
  var s = img.shape()
  var f = _orb_detect(img, s[0], s[1], s[2], nfeatures)
  if f == nil:
    raise RuntimeException('orb_detect: ' + _last_error())
  return _features_from(f, s[1], s[0], 'orb_detect')

func _features_desc_type_of(f: Features) -> int:
  if f.descriptors.shape()[1] > 32:
    return 1
  return 0

type Matches object:
  var pairs            # int32 [M, 2]: index in a, index in b
  var distances        # float32 [M]

# Cross-checked brute-force matching of two ORB feature sets.
func match_features(a: Features, b: Features) -> Matches:
  if a.points == nil or b.points == nil:
    return Matches(nil, nil)
  if _features_desc_type_of(a) != 0:
    raise RuntimeException('match_features: expects ORB (uint8) descriptors; use LightGlue for ALIKED features')
  var n1 = a.descriptors.shape()[0]
  var n2 = b.descriptors.shape()[0]
  var pairs = tensor([n1, 2], dtype='int32')
  var dists = tensor([n1], dtype='float32')
  var m = _match_hamming(a.descriptors, n1, b.descriptors, n2, a.descriptors.shape()[1], pairs, dists)
  if m < 0:
    raise RuntimeException('match_features: ' + _last_error())
  if m == 0:
    return Matches(nil, nil)
  return Matches(pairs[0:m, 0:2], dists[0:m])


#
# ---- stereo depth ----

# Disparity map from a rectified grayscale pair; float32 [H, W, 1], in pixels.
# num_disparities must be a multiple of 16.
func disparity(left: tensor, right: tensor, num_disparities: int = 64, block_size: int = 9, min_disparity: int = 0) -> tensor:
  var s = left.shape()
  if s[2] != 1:
    raise RuntimeException('disparity: expects grayscale images')
  var out = tensor([s[0], s[1], 1], dtype='float32')
  if _stereo_sgbm(left, right, s[0], s[1], min_disparity, num_disparities, block_size, out) != 0:
    raise RuntimeException('disparity: ' + _last_error())
  return out


