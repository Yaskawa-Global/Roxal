#
# ---- ChArUco boards (calibration targets) ----

type CharucoBoard object:
  var _b
  var squares_x: int = 0
  var squares_y: int = 0

# A squares_x x squares_y chessboard with ArUco markers in the white squares.
# square_size/marker_size in your physical unit (e.g. meters).
func charuco_board(squares_x: int, squares_y: int, square_size: real, marker_size: real, dictionary = ArucoDict.Dict4x4_50) -> CharucoBoard:
  var b = _charuco_board_new(squares_x, squares_y, square_size, marker_size, dictionary)
  if b == nil:
    raise RuntimeException('charuco_board: ' + _last_error())
  return CharucoBoard(b, squares_x, squares_y)

# Render the board (uint8 [height, width, 1]) for printing/display.
func board_image(board: CharucoBoard, width: int, height: int, margin: int = 0) -> tensor:
  var out = tensor([height, width, 1], dtype='uint8')
  if _charuco_board_image(board._b, out, height, width, margin) != 0:
    raise RuntimeException('board_image: ' + _last_error())
  return out

type CharucoDetection object:
  var corners          # float32 [N, 2] refined corner image points
  var ids              # int32 [N] board corner ids
  var object_points    # float32 [N, 3] matching board-frame 3D points

# Detect the board's chessboard corners; nil when none are found. The result
# pairs image corners with board-frame object points, ready for calibrate_camera.
func detect_charuco(img: tensor, board: CharucoBoard) -> CharucoDetection:
  var s = img.shape()
  var r = _charuco_detect(board._b, img, s[0], s[1], s[2])
  if r == nil:
    raise RuntimeException('detect_charuco: ' + _last_error())
  var n = _charuco_count(r)
  if n == 0:
    return nil
  var corners = tensor([n, 2], dtype='float32')
  var ids = tensor([n], dtype='int32')
  if _charuco_copy(r, corners, ids) != 0:
    raise RuntimeException('detect_charuco: ' + _last_error())
  var obj = tensor([n, 3], dtype='float32')
  if _charuco_match(board._b, r, obj, corners) != 0:
    raise RuntimeException('detect_charuco: ' + _last_error())
  return CharucoDetection(corners, ids, obj)


#
# ---- stereo calibration and rectification ----

type StereoCalibration object:
  var rotation         # float64 [3, 3]: right-camera rotation w.r.t. left
  var translation      # float64 [3]: right-camera translation w.r.t. left
  var error: real = 0.0

# Relative pose of a rigid two-camera pair. Each camera must be individually
# calibrated first; per-view point lists mirror calibrate_camera.
func stereo_calibrate(object_points: list, left_points: list, right_points: list, left: Calibration, right: Calibration, width: int, height: int) -> StereoCalibration:
  var nviews = len(object_points)
  var total = 0
  for v in object_points:
    total = total + v.shape()[0]
  var obj = tensor([total, 3], dtype='float32')
  var ipl = tensor([total, 2], dtype='float32')
  var ipr = tensor([total, 2], dtype='float32')
  var counts = tensor([nviews], dtype='int32')
  var off = 0
  for i in range(0 ..< nviews):
    var n = object_points[i].shape()[0]
    obj[off:off+n, 0:3] = object_points[i]
    ipl[off:off+n, 0:2] = left_points[i]
    ipr[off:off+n, 0:2] = right_points[i]
    counts[i] = n
    off = off + n
  var r = tensor([3, 3])
  var t = tensor([3])
  var err = _stereo_calibrate(obj, ipl, ipr, counts, nviews, width, height,
                              left.camera_matrix, left.dist_coeffs, left.dist_coeffs.shape()[0],
                              right.camera_matrix, right.dist_coeffs, right.dist_coeffs.shape()[0], r, t)
  if err < 0.0:
    raise RuntimeException('stereo_calibrate: ' + _last_error())
  return StereoCalibration(r, t, err)

type StereoRectification object:
  var left_rotation        # float64 [3, 3]
  var right_rotation       # float64 [3, 3]
  var left_projection      # float64 [3, 4]
  var right_projection     # float64 [3, 4]
  var q                    # float64 [4, 4] disparity-to-depth mapping

# Rectification transforms that make the two image planes row-aligned (so
# disparity() can search along rows).
func stereo_rectify(left: Calibration, right: Calibration, stereo: StereoCalibration, width: int, height: int) -> StereoRectification:
  var r1 = tensor([3, 3])
  var r2 = tensor([3, 3])
  var p1 = tensor([3, 4])
  var p2 = tensor([3, 4])
  var q = tensor([4, 4])
  if _stereo_rectify(left.camera_matrix, left.dist_coeffs, left.dist_coeffs.shape()[0],
                     right.camera_matrix, right.dist_coeffs, right.dist_coeffs.shape()[0],
                     width, height, stereo.rotation, stereo.translation, r1, r2, p1, p2, q) != 0:
    raise RuntimeException('stereo_rectify: ' + _last_error())
  return StereoRectification(r1, r2, p1, p2, q)

# Undistort + rectify one camera's image (use left_/right_ rotation+projection
# from stereo_rectify for the matching camera).
func rectify(img: tensor, calib: Calibration, rotation: tensor, projection: tensor) -> tensor:
  var s = img.shape()
  var out = tensor([s[0], s[1], s[2]], dtype='uint8')
  if _rectify_remap(img, s[0], s[1], s[2], out, calib.camera_matrix,
                    calib.dist_coeffs, calib.dist_coeffs.shape()[0], rotation, projection) != 0:
    raise RuntimeException('rectify: ' + _last_error())
  return out


#
# ---- planar geometry estimation ----

type HomographyMethod enum:
  LeastSquares = 0
  Lmeds = 4
  Ransac = 8
  Rho = 16

# 3x3 float64 perspective transform mapping src_points onto dst_points
# (float32 [N, 2] each, N >= 4).
func find_homography(src_points: tensor, dst_points: tensor, method = HomographyMethod.Ransac, threshold: real = 3.0) -> tensor:
  var n = src_points.shape()[0]
  var h = tensor([3, 3])
  if _find_homography(src_points, dst_points, n, method, threshold, h) != 0:
    raise RuntimeException('find_homography: ' + _last_error())
  return h

# 2x3 float64 affine transform mapping src_points onto dst_points (N >= 3).
func estimate_affine(src_points: tensor, dst_points: tensor) -> tensor:
  var n = src_points.shape()[0]
  var m = tensor([2, 3])
  if _estimate_affine_2d(src_points, dst_points, n, m) != 0:
    raise RuntimeException('estimate_affine: ' + _last_error())
  return m


