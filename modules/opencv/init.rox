#
# ---- color/intensity segmentation ----

# Mask of pixels whose channels all lie within [lower, upper] (lists, one bound
# per channel; e.g. HSV bounds after cvt_color(img, ColorCode.Rgb2Hsv)).
# Returns a binary [H, W, 1] mask (255 inside the range).
func in_range(img: tensor, lower, upper) -> tensor:
  var s = img.shape()
  var c = s[2]
  var lo = [0.0, 0.0, 0.0, 0.0]
  var hi = [0.0, 0.0, 0.0, 0.0]
  for i in range(0 ..< c):
    lo[i] = lower[i]
    hi[i] = upper[i]
  var out = tensor([s[0], s[1], 1], dtype='uint8')
  if _in_range(img, s[0], s[1], c, out, lo[0], lo[1], lo[2], lo[3], hi[0], hi[1], hi[2], hi[3]) != 0:
    raise RuntimeException('in_range: ' + _last_error())
  return out

type Blob object:
  var x: int = 0
  var y: int = 0
  var width: int = 0
  var height: int = 0
  var area: int = 0
  var center_x: real = 0.0
  var center_y: real = 0.0

# Connected components of a binary mask as a list of Blob (background excluded),
# optionally dropping blobs smaller than min_area pixels.
func connected_components(mask: tensor, min_area: int = 1) -> list:
  var s = mask.shape()
  if s[2] != 1:
    raise RuntimeException('connected_components: expects a binary [H, W, 1] mask')
  var cc = _cc_new(mask, s[0], s[1])
  if cc == nil:
    raise RuntimeException('connected_components: ' + _last_error())
  var n = _cc_count(cc)
  var result = []
  if n <= 1:
    return result
  var stats = tensor([n, 5], dtype='int32')
  var cents = tensor([n, 2])
  if _cc_copy(cc, stats, cents) != 0:
    raise RuntimeException('connected_components: ' + _last_error())
  for i in range(1 ..< n):
    if int(stats[i, 4]) >= min_area:
      result.append(Blob(int(stats[i, 0]), int(stats[i, 1]), int(stats[i, 2]),
                         int(stats[i, 3]), int(stats[i, 4]), cents[i, 0], cents[i, 1]))
  return result

type BackgroundSubtractor object:
  var _b

  proc init(history: int = 500, threshold: real = 16.0, shadows: bool = true):
    var sh = 0
    if shadows:
      sh = 1
    _b = _mog2_new(history, threshold, sh)
    if _b == nil:
      raise RuntimeException('BackgroundSubtractor: ' + _last_error())

  # Feed the next frame; returns the foreground mask [H, W, 1]
  # (255 foreground, 127 shadow when shadows are on).
  func apply(img: tensor, learning_rate: real = -1.0) -> tensor:
    var s = img.shape()
    var mask = tensor([s[0], s[1], 1], dtype='uint8')
    if _mog2_apply(_b, img, s[0], s[1], s[2], mask, learning_rate) != 0:
      raise RuntimeException('BackgroundSubtractor.apply: ' + _last_error())
    return mask


#
# ---- contour analysis kit ----

# Draw contours ([N, 2] int32 tensors, as from find_contours) onto the image
# in place; thickness -1 fills.
proc draw_contours(img: tensor, contours: list, color, thickness: int = 2):
  var s = img.shape()
  for pts in contours:
    if _draw_contour(img, s[0], s[1], s[2], pts, pts.shape()[0], color[0], color[1], color[2], thickness) != 0:
      raise RuntimeException('draw_contours: ' + _last_error())

func convex_hull(points: tensor) -> tensor:
  var n = points.shape()[0]
  var out = tensor([n, 2], dtype='int32')
  var m = _convex_hull(points, n, out)
  if m < 0:
    raise RuntimeException('convex_hull: ' + _last_error())
  return out[0:m, 0:2]

# Simplify a contour (Douglas-Peucker); epsilon is the max deviation in pixels.
func approx_poly(points: tensor, epsilon: real, closed: bool = true) -> tensor:
  var n = points.shape()[0]
  var cl = 0
  if closed:
    cl = 1
  var out = tensor([n, 2], dtype='int32')
  var m = _approx_poly(points, n, epsilon, cl, out)
  if m < 0:
    raise RuntimeException('approx_poly: ' + _last_error())
  return out[0:m, 0:2]

type RotatedRect object:
  var center_x: real = 0.0
  var center_y: real = 0.0
  var width: real = 0.0
  var height: real = 0.0
  var angle: real = 0.0     # degrees

# Minimum-area (rotated) bounding rectangle of a point set.
func min_area_rect(points: tensor) -> RotatedRect:
  var n = points.shape()[0]
  var out = tensor([5])
  if _min_area_rect(points, n, out) != 0:
    raise RuntimeException('min_area_rect: ' + _last_error())
  return RotatedRect(out[0], out[1], out[2], out[3], out[4])

# The 4 corners of a RotatedRect as float32 [4, 2] (e.g. to draw it).
func box_points(rect: RotatedRect) -> tensor:
  var out = tensor([4, 2], dtype='float32')
  if _box_points(rect.center_x, rect.center_y, rect.width, rect.height, rect.angle, out) != 0:
    raise RuntimeException('box_points: ' + _last_error())
  return out


#
# ---- template matching ----

type TemplateMatch object:
  var x: int = 0
  var y: int = 0
  var score: real = 0.0

# Best location of templ inside img. With the default CcoeffNormed method the
# score is 1.0 for a perfect match; for Sqdiff methods lower is better.
func find_template(img: tensor, templ: tensor, method = TemplateMethod.CcoeffNormed) -> TemplateMatch:
  var s = img.shape()
  var ts = templ.shape()
  var loc = tensor([2], dtype='int32')
  var score = tensor([1])
  if _match_template(img, s[0], s[1], s[2], templ, ts[0], ts[1], method, loc, score) != 0:
    raise RuntimeException('find_template: ' + _last_error())
  return TemplateMatch(int(loc[0]), int(loc[1]), score[0])


#
# ---- QR codes ----

type QrCode object:
  var text: string = ''
  var corners        # float32 [4, 2]

# Detect and decode all QR codes in the image.
func detect_qr(img: tensor) -> list:
  var s = img.shape()
  var r = _qr_detect(img, s[0], s[1], s[2])
  if r == nil:
    raise RuntimeException('detect_qr: ' + _last_error())
  var result = []
  for i in range(0 ..< _qr_count(r)):
    var corners = tensor([4, 2], dtype='float32')
    if _qr_corners(r, i, corners) != 0:
      raise RuntimeException('detect_qr: ' + _last_error())
    result.append(QrCode(_qr_text(r, i), corners))
  return result

# Render text as a QR code image (uint8 [side, side, 1]).
func generate_qr(text: string, side: int = 200) -> tensor:
  var out = tensor([side, side, 1], dtype='uint8')
  if _qr_encode(text, side, out) != 0:
    raise RuntimeException('generate_qr: ' + _last_error())
  return out


#
# ---- stereo depth to 3D + cached rectification ----

# Turn a disparity map into 3D points (float32 [H, W, 3], same unit as the
# calibration) using the Q matrix from stereo_rectify. With mark_missing,
# pixels at the minimal disparity (SGBM's invalid marker) get a huge Z so they
# are easy to filter out.
func reproject_3d(disparity: tensor, q: tensor, mark_missing: bool = true) -> tensor:
  var s = disparity.shape()
  var mm = 0
  if mark_missing:
    mm = 1
  var out = tensor([s[0], s[1], 3], dtype='float32')
  if _reproject_3d(disparity, s[0], s[1], q, out, mm) != 0:
    raise RuntimeException('reproject_3d: ' + _last_error())
  return out

# Precomputed undistort+rectify maps: build once, apply per frame
# (rectify() rebuilds the maps on every call — fine for stills, not for loops).
type RectifyMap object:
  var _m
  var width: int = 0
  var height: int = 0

  proc init(calib: Calibration, rotation: tensor, projection: tensor, width_: int, height_: int):
    width = width_
    height = height_
    _m = _rectify_map_new(calib.camera_matrix, calib.dist_coeffs, calib.dist_coeffs.shape()[0],
                          rotation, projection, width_, height_)
    if _m == nil:
      raise RuntimeException('RectifyMap: ' + _last_error())

  func apply(img: tensor) -> tensor:
    var s = img.shape()
    var out = tensor([s[0], s[1], s[2]], dtype='uint8')
    if _rectify_map_apply(_m, img, s[0], s[1], s[2], out) != 0:
      raise RuntimeException('RectifyMap.apply: ' + _last_error())
    return out


#
# ---- optical flow (grayscale inputs) ----

# Strong corner points to seed sparse tracking; float32 [M, 2].
func good_features(img: tensor, max_corners: int = 100, quality: real = 0.01, min_distance: real = 10.0) -> tensor:
  var s = img.shape()
  if s[2] != 1:
    raise RuntimeException('good_features: expects a grayscale image')
  var out = tensor([max_corners, 2], dtype='float32')
  var m = _good_features(img, s[0], s[1], max_corners, quality, min_distance, out)
  if m < 0:
    raise RuntimeException('good_features: ' + _last_error())
  return out[0:m, 0:2]

type FlowResult object:
  var points         # float32 [N, 2]: tracked positions in the next frame
  var status         # uint8 [N]: 1 = tracked, 0 = lost

# Sparse Lucas-Kanade optical flow: where did these points move to?
func flow_points(prev: tensor, next: tensor, points: tensor) -> FlowResult:
  var s = prev.shape()
  var n = points.shape()[0]
  var out = tensor([n, 2], dtype='float32')
  var status = tensor([n], dtype='uint8')
  if _flow_lk(prev, next, s[0], s[1], points, n, out, status) != 0:
    raise RuntimeException('flow_points: ' + _last_error())
  return FlowResult(out, status)

# Dense Farneback optical flow: per-pixel (dx, dy) as float32 [H, W, 2].
func flow_dense(prev: tensor, next: tensor) -> tensor:
  var s = prev.shape()
  if s[2] != 1:
    raise RuntimeException('flow_dense: expects grayscale images')
  var out = tensor([s[0], s[1], 2], dtype='float32')
  if _flow_dense(prev, next, s[0], s[1], out) != 0:
    raise RuntimeException('flow_dense: ' + _last_error())
  return out

# Contrast-limited adaptive histogram equalization (grayscale).
func clahe(img: tensor, clip_limit: real = 2.0, tiles: int = 8) -> tensor:
  var s = img.shape()
  if s[2] != 1:
    raise RuntimeException('clahe: expects a grayscale image')
  var out = tensor([s[0], s[1], 1], dtype='uint8')
  if _clahe(img, s[0], s[1], out, clip_limit, tiles) != 0:
    raise RuntimeException('clahe: ' + _last_error())
  return out


#
# ---- fisheye camera model (wide-FOV lenses) ----

# Like calibrate_camera but with the fisheye distortion model
# (dist_coeffs is float64 [4]).
func calibrate_camera_fisheye(object_points: list, image_points: list, width: int, height: int) -> Calibration:
  var nviews = len(object_points)
  var total = 0
  for v in object_points:
    total = total + v.shape()[0]
  var obj = tensor([total, 3], dtype='float32')
  var imgp = tensor([total, 2], dtype='float32')
  var counts = tensor([nviews], dtype='int32')
  var off = 0
  for i in range(0 ..< nviews):
    var n = object_points[i].shape()[0]
    obj[off:off+n, 0:3] = object_points[i]
    imgp[off:off+n, 0:2] = image_points[i]
    counts[i] = n
    off = off + n
  var cam = tensor([3, 3])
  var dist = tensor([4])
  var err = _fisheye_calibrate(obj, imgp, counts, nviews, width, height, cam, dist)
  if err < 0.0:
    raise RuntimeException('calibrate_camera_fisheye: ' + _last_error())
  return Calibration(cam, dist, err)

func undistort_fisheye(img: tensor, camera_matrix: tensor, dist_coeffs: tensor) -> tensor:
  var s = img.shape()
  var out = tensor([s[0], s[1], s[2]], dtype='uint8')
  if _fisheye_undistort(img, s[0], s[1], s[2], out, camera_matrix, dist_coeffs) != 0:
    raise RuntimeException('undistort_fisheye: ' + _last_error())
  return out

func project_points_fisheye(object_points: tensor, pose: Pose, camera_matrix: tensor, dist_coeffs: tensor) -> tensor:
  var n = object_points.shape()[0]
  var out = tensor([n, 2], dtype='float32')
  if _fisheye_project(object_points, n, pose.rvec, pose.tvec, camera_matrix, dist_coeffs, out) != 0:
    raise RuntimeException('project_points_fisheye: ' + _last_error())
  return out


#
# ---- feature-match visualization (pure Roxal) ----

# Side-by-side canvas with keypoints and match lines; a debugging aid.
func draw_matches(img_a: tensor, fa: Features, img_b: tensor, fb: Features, matches: Matches, color = [0, 255, 0], max_draw: int = 50) -> tensor:
  var sa = img_a.shape()
  var sb = img_b.shape()
  var h = sa[0]
  if sb[0] > h:
    h = sb[0]
  var canvas = tensor([h, sa[1] + sb[1], 3], dtype='uint8')
  canvas[0:sa[0], 0:sa[1], 0:3] = img_a
  canvas[0:sb[0], sa[1]:sa[1]+sb[1], 0:3] = img_b
  if matches.pairs == nil:
    return canvas
  var n = matches.pairs.shape()[0]
  if n > max_draw:
    n = max_draw
  for i in range(0 ..< n):
    var pa = int(matches.pairs[i, 0])
    var pb = int(matches.pairs[i, 1])
    var xa = int(fa.points[pa, 0])
    var ya = int(fa.points[pa, 1])
    var xb = int(fb.points[pb, 0]) + sa[1]
    var yb = int(fb.points[pb, 1])
    circle(canvas, xa, ya, 3, color)
    circle(canvas, xb, yb, 3, color)
    line(canvas, xa, ya, xb, yb, color)
  return canvas
