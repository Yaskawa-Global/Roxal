#
# public API

func version() -> string:
  return _version()

# Read an image file as a uint8 [H, W, C] RGB tensor. channels: 3 (RGB, default),
# 1 (grayscale) or 4 (RGBA).
func imread(path: string, channels: int = 3) -> tensor:
  var m = _imread(path, channels)
  if m == nil:
    raise RuntimeException('imread: ' + _last_error())
  var h = _mat_rows(m)
  var w = _mat_cols(m)
  var c = _mat_channels(m)
  var img = tensor([h, w, c], dtype='uint8')
  if _mat_copy_to(m, img, h * w * c) != 0:
    raise RuntimeException('imread: ' + _last_error())
  return img

# Write a uint8 [H, W, C] RGB tensor to an image file (format from extension).
proc imwrite(path: string, img: tensor):
  var s = img.shape()
  if _imwrite(path, img, s[0], s[1], s[2]) != 0:
    raise RuntimeException('imwrite: ' + _last_error())

# Resize to the given width x height.
func resize(img: tensor, width: int, height: int, interpolation = Interpolation.Linear) -> tensor:
  var s = img.shape()
  var out = tensor([height, width, s[2]], dtype='uint8')
  if _resize(img, s[0], s[1], s[2], out, height, width, interpolation) != 0:
    raise RuntimeException('resize: ' + _last_error())
  return out

# Convert between color spaces (images stay RGB-ordered at this API).
func cvt_color(img: tensor, code) -> tensor:
  var s = img.shape()
  var dc = _cvt_channels(code)
  var out = tensor([s[0], s[1], dc], dtype='uint8')
  if _cvt_color(img, s[0], s[1], s[2], out, dc, code) != 0:
    raise RuntimeException('cvt_color: ' + _last_error())
  return out

# Convenience: RGB -> single-channel grayscale [H, W, 1]
func grayscale(img: tensor) -> tensor:
  return cvt_color(img, ColorCode.Rgb2Gray)

func gaussian_blur(img: tensor, ksize: int, sigma: real = 0.0) -> tensor:
  var s = img.shape()
  var out = tensor([s[0], s[1], s[2]], dtype='uint8')
  if _gaussian_blur(img, s[0], s[1], s[2], out, ksize, sigma) != 0:
    raise RuntimeException('gaussian_blur: ' + _last_error())
  return out

# Edge detection on a grayscale [H, W, 1] image.
func canny(img: tensor, threshold1: real, threshold2: real) -> tensor:
  var s = img.shape()
  if s[2] != 1:
    raise RuntimeException('canny: expects a grayscale image (use grayscale() first)')
  var out = tensor([s[0], s[1], 1], dtype='uint8')
  if _canny(img, s[0], s[1], out, threshold1, threshold2) != 0:
    raise RuntimeException('canny: ' + _last_error())
  return out

# Threshold a grayscale [H, W, 1] image.
func threshold(img: tensor, thresh: real, maxval: real = 255.0, mode = ThresholdType.Binary) -> tensor:
  var s = img.shape()
  if s[2] != 1:
    raise RuntimeException('threshold: expects a grayscale image (use grayscale() first)')
  var out = tensor([s[0], s[1], 1], dtype='uint8')
  if _threshold(img, s[0], s[1], out, thresh, maxval, mode) < 0.0:
    raise RuntimeException('threshold: ' + _last_error())
  return out

# Otsu automatic threshold (returns the binarized image).
func threshold_otsu(img: tensor, maxval: real = 255.0) -> tensor:
  var s = img.shape()
  if s[2] != 1:
    raise RuntimeException('threshold_otsu: expects a grayscale image (use grayscale() first)')
  var out = tensor([s[0], s[1], 1], dtype='uint8')
  if _threshold(img, s[0], s[1], out, 0.0, maxval, 8) < 0.0:
    raise RuntimeException('threshold_otsu: ' + _last_error())
  return out

# Rotate by a 90-degree step (see Rotation); 90/270 swap width and height.
func rotate(img: tensor, rotation) -> tensor:
  var s = img.shape()
  var dh = s[0]
  var dw = s[1]
  if rotation != Rotation.Half:
    dh = s[1]
    dw = s[0]
  var out = tensor([dh, dw, s[2]], dtype='uint8')
  if _rotate(img, s[0], s[1], s[2], out, dh, dw, rotation) != 0:
    raise RuntimeException('rotate: ' + _last_error())
  return out


#
# drawing (in place, on the passed image; color is [r, g, b], thickness -1 = filled)

proc line(img: tensor, x1: int, y1: int, x2: int, y2: int, color, thickness: int = 1):
  var s = img.shape()
  if _line(img, s[0], s[1], s[2], x1, y1, x2, y2, color[0], color[1], color[2], thickness) != 0:
    raise RuntimeException('line: ' + _last_error())

proc rectangle(img: tensor, x: int, y: int, width: int, height: int, color, thickness: int = 1):
  var s = img.shape()
  if _rectangle(img, s[0], s[1], s[2], x, y, width, height, color[0], color[1], color[2], thickness) != 0:
    raise RuntimeException('rectangle: ' + _last_error())

proc circle(img: tensor, cx: int, cy: int, radius: int, color, thickness: int = 1):
  var s = img.shape()
  if _circle(img, s[0], s[1], s[2], cx, cy, radius, color[0], color[1], color[2], thickness) != 0:
    raise RuntimeException('circle: ' + _last_error())

proc put_text(img: tensor, text: string, x: int, y: int, color, scale: real = 1.0, font = Font.Simplex, thickness: int = 1):
  var s = img.shape()
  if _put_text(img, s[0], s[1], s[2], text, x, y, font, scale, color[0], color[1], color[2], thickness) != 0:
    raise RuntimeException('put_text: ' + _last_error())


#
# geometric transforms

# 2x3 float64 affine matrix for rotation around (cx, cy) by angle degrees.
func rotation_matrix(cx: real, cy: real, angle: real, scale: real = 1.0) -> tensor:
  var m = tensor([2, 3])
  if _rotation_matrix_2d(cx, cy, angle, scale, m) != 0:
    raise RuntimeException('rotation_matrix: ' + _last_error())
  return m

# Apply a 2x3 float64 affine matrix; output is width x height.
func warp_affine(img: tensor, m: tensor, width: int, height: int, interpolation = Interpolation.Linear) -> tensor:
  var s = img.shape()
  var out = tensor([height, width, s[2]], dtype='uint8')
  if _warp_affine(img, s[0], s[1], s[2], out, height, width, m, interpolation) != 0:
    raise RuntimeException('warp_affine: ' + _last_error())
  return out

# Apply a 3x3 float64 perspective matrix; output is width x height.
func warp_perspective(img: tensor, m: tensor, width: int, height: int, interpolation = Interpolation.Linear) -> tensor:
  var s = img.shape()
  var out = tensor([height, width, s[2]], dtype='uint8')
  if _warp_perspective(img, s[0], s[1], s[2], out, height, width, m, interpolation) != 0:
    raise RuntimeException('warp_perspective: ' + _last_error())
  return out


#
# contours (on a binary grayscale image, e.g. from threshold() or canny())

# Returns a list of contours, each an int32 [N, 2] tensor of x, y points.
func find_contours(img: tensor, mode = ContourMode.External, method = ContourApprox.Simple) -> list:
  var s = img.shape()
  if s[2] != 1:
    raise RuntimeException('find_contours: expects a binary grayscale image')
  var cc = _find_contours(img, s[0], s[1], mode, method)
  if cc == nil:
    raise RuntimeException('find_contours: ' + _last_error())
  var result = []
  var n = _contours_count(cc)
  for i in range(..<n):
    var ln = _contour_len(cc, i)
    var pts = tensor([ln, 2], dtype='int32')
    if _contour_copy(cc, i, pts) != 0:
      raise RuntimeException('find_contours: ' + _last_error())
    result.append(pts)
  return result

func contour_area(points: tensor) -> real:
  var s = points.shape()
  var a = _contour_area(points, s[0])
  if a < 0.0:
    raise RuntimeException('contour_area: ' + _last_error())
  return a

# Bounding box of an int32 [N, 2] point set as [x, y, width, height].
func bounding_rect(points: tensor) -> list:
  var s = points.shape()
  var out = tensor([4], dtype='int32')
  if _bounding_rect(points, s[0], out) != 0:
    raise RuntimeException('bounding_rect: ' + _last_error())
  return [int(out[0]), int(out[1]), int(out[2]), int(out[3])]


#
# video

type VideoCapture object:
  var _cap
  var width: int = 0
  var height: int = 0

  proc init(cap):
    _cap = cap
    width = int(_cap_get(cap, CapProp.FrameWidth))
    height = int(_cap_get(cap, CapProp.FrameHeight))

  # Next frame as a uint8 [H, W, 3] RGB tensor, or nil at end of stream.
  func read() -> tensor:
    var frame = tensor([height, width, 3], dtype='uint8')
    var rc = _cap_read(_cap, frame, height, width)
    if rc < 0:
      raise RuntimeException('VideoCapture.read: ' + _last_error())
    if rc == 0:
      return nil
    return frame

  func fps() -> real:
    return _cap_get(_cap, CapProp.Fps)

  func get(prop) -> real:
    return _cap_get(_cap, prop)

  proc set(prop, value: real):
    if _cap_set(_cap, prop, value) != 0:
      raise RuntimeException('VideoCapture.set: ' + _last_error())

  # Release the camera/file now (GC would eventually, but this is deterministic).
  proc close():
    _cap_close(_cap)

# Open a camera by index.
func open_camera(index: int = 0) -> VideoCapture:
  var cap = _cap_open(index)
  if cap == nil:
    raise RuntimeException('open_camera: ' + _last_error())
  return VideoCapture(cap)

# Open a video file.
func open_video(path: string) -> VideoCapture:
  var cap = _cap_open_file(path)
  if cap == nil:
    raise RuntimeException('open_video: ' + _last_error())
  return VideoCapture(cap)

type VideoWriter object:
  var _w

  proc init(path: string, fps: real, width: int, height: int, codec: string = 'mp4v'):
    _w = _writer_open(path, codec, fps, width, height)
    if _w == nil:
      raise RuntimeException('VideoWriter: ' + _last_error())

  # Append a uint8 [H, W, 3] RGB frame (must match the writer's size).
  proc write(frame: tensor):
    var s = frame.shape()
    if _writer_write(_w, frame, s[0], s[1]) != 0:
      raise RuntimeException('VideoWriter.write: ' + _last_error())

  # Flush and close the file. Do call this — GC finalization is not prompt
  # enough to guarantee a playable file at script end.
  proc close():
    _writer_close(_w)


