// web — expose Roxal state to a web UI.
//
// Works under two hosts: the WebAssembly build in a browser tab, and a native
// VM started with `roxal --web-host`, which serves a browser page over a local
// WebSocket. Scripts are the same under both.
//
// EXPERIMENTAL: new, not yet exercised by a real application; expect rough edges
// and API changes.
//
// Roxal owns the state and the logic; the view layer (React, Svelte, plain DOM —
// it does not matter) subscribes to it. This is the counterpart to `dom`: use
// `dom` to poke at the page directly, use `web` when a UI framework should render
// from your data.
//
//   import web
//
//   type App object:
//     var temp :signal = signal(30, 0)
//     var target :real = 20
//
//     proc set_target(v :real):
//       self.target = v
//
//   web.expose("app", App())
//   web.serve()
//
// On the JS side each exposed object becomes a store with subscribe/getSnapshot/
// call — the shape React's useSyncExternalStore wants, and equally usable from
// Svelte, Vue, or a hand-written render function.
//
// What crosses over:
//   * public `var` properties, by value
//   * computed properties (those with getters), read through the getter
//   * public methods, callable from JS; each returns a Promise
//   * a `signal` property crosses as its current value, and its changes are
//     observed on the signal itself (the property slot never changes). A
//     clock-driven signal updates the view at its clock rate — measured exactly
//     10/s for a 10 Hz network — so you can compute at sensor rate and publish at
//     display rate. A source signal poked with set() is NOT throttled by its
//     declared frequency; it fires per set().
//
// Changes are coalesced: a burst of writes in one turn produces one UI update.

// For the Ide language service and Workspace file service below. This makes
// web depend on the inspect and fileio modules; both are on by default
// (ROXAL_ENABLE_INSPECT, ROXAL_ENABLE_FILEIO).
import inspect
import fileio
import dfdoc
import debug

@builtin
proc expose(name:string, obj):
  """Publish `obj` (an object instance) to the UI under `name`. Its public
  properties become the store's snapshot and its public methods become callable.
  Calling again with the same name is a no-op."""

@builtin
proc notify(name:string, property=nil):
  """Re-read and republish `property` (or the whole object). Needed only when a
  value changed without an assignment — mutating a list or dict in place, or a
  computed property derived from fields other than its own backing one."""

@builtin
proc _serve(seconds=nil):
  """Native half of serve() -- parks the script in the dispatch loop."""

proc serve(seconds=nil):
  """Keep the app alive, delivering UI events and publishing state changes, until
  web.stop() is called or `seconds` elapses. A UI script ends with this.

  Handlers and method calls only run while the script is alive, so a script that
  exposes state and then finishes does nothing.

  Also (re)publishes the "ide" language service and "workspace" file/REPL
  service before parking -- see Ide and Workspace below."""
  _ensure_ide()
  _serve(seconds)

@builtin
proc stop():
  """Make a running web.serve() return."""

# The page's services locate the standard library and the user's files
# through sys.host_dir('stdlib') / sys.host_dir('data') -- the host reports
# them (fixed mounts in the wasm build, real directories under
# `roxal --web-host`).

# An output view for a diagram harness: holds an image-valued output signal
# so the page paints each new frame at the output node. A signal-valued
# property crosses as its current value and is observed on the signal, so
# every frame that changes reaches the page, coalesced per host-loop turn.
type ImageView object:
  var frame :signal = nil
  proc init(sig :signal):
    frame = sig

# Any signal as a store: the page reads its current value and every change.
# The harness uses it for a feed's frame count (an FPS readout).
type SignalView object:
  var value :signal = nil
  proc init(sig :signal):
    value = sig

# ---------------------------------------------------------------------------
# The IDE language service. Owned by this module so an editor never has to mix
# service plumbing into the user's script: any app that calls web.serve() gets
# an "ide" store for free, and the visible editor buffer stays the user's own
# code with its own line numbers.
#
# An ACTOR, so a slow parse of a large buffer runs on the service's own thread
# and stalls neither the store pump nor the running app. Recreated by every
# serve() call rather than at module load: actor threads are joined when their
# script ends, so a service from a previous run is dead by the time the next
# run parks -- and module top-level only executes once per VM anyway.
#
# (Requires the inspect module; wasm builds compile it in by default.)

type Ide actor:
  # One parse per version of the buffer, shared by every query about it. All
  # private -- actors admit no shared properties, so this store is methods-only.
  private var checks :int = 0
  private var seen_src :string = ""
  private var seen :bool = false
  private var seen_errors :list = []
  private var seen_nodes :list = []

  private func _parse(src :string):
    if seen and src == seen_src:
      return
    var r = inspect.parse(src, "<buffer>", true)
    seen_src = src
    seen_errors = r.errors
    # Flattened once as well: walk() rebuilds the whole list, and on a large
    # buffer that is the larger half of a hover. Only the flat list is kept.
    var tree = r.tree
    if tree == nil:
      seen_nodes = []
    else:
      seen_nodes = inspect.walk(tree)
    seen = true

  # A tolerant parse yields diagnostics; the tree comes back partial but the
  # error list is exactly what an editor's marker API wants.
  func check(src :string) -> list:
    checks = checks + 1
    _parse(src)
    var out = []
    for e in seen_errors:
      out.append({'line': e.line, 'col': e.col, 'message': e.message})
    return out

  # Innermost node containing (line, col). deduced_type is what makes this
  # worth more than a tokenizer could ever give.
  func describe(src :string, line :int, col :int) -> dict:
    var out = {}
    _parse(src)
    if len(seen_nodes) == 0:
      return out
    var best = nil
    var best_span = 1000000
    for n in seen_nodes:
      if n.start_line == 0:
        continue
      var after_start = n.start_line < line or (n.start_line == line and n.start_col <= col)
      var before_end = n.end_line > line or (n.end_line == line and n.end_col >= col)
      if after_start and before_end:
        var span = (n.end_line - n.start_line) * 1000 + (n.end_col - n.start_col)
        if span < best_span:
          best_span = span
          best = n
    if best == nil:
      return out
    out.kind = best.kind()
    out.line = best.start_line
    out.col = best.start_col
    if best.deduced_type != nil:
      out['type'] = best.deduced_type      # 'type' is a keyword, so no dot form here
    return out

# ---------------------------------------------------------------------------
# IDE file service + REPL, a second actor so a slow language-service parse
# never delays a file save (and vice versa). File operations use fileio --
# the same API user scripts get -- against /data, which the wasm host backs
# with OPFS in the browser (persistent across reloads) and a plain directory
# elsewhere. All synchronous: they run on the actor's own thread.
type Workspace actor:
  func fs_list(dir :string) -> list:
    var entries = fileio.list_dir(dir)
    if entries == nil:
      return []
    return entries

  func fs_read(path :string):
    if not fileio.file_exists(path):
      return nil
    return fileio.read_file(path)

  func fs_write(path :string, text :string) -> bool:
    var f = fileio.open(path, write=true)
    if f == false:
      return false
    fileio.write(f, text)
    return fileio.close(f)

  func fs_delete(path :string) -> bool:
    return fileio.delete_file(path)

  func fs_exists(path :string) -> bool:
    return fileio.file_exists(path)

  # One REPL entry. Expressions are print-wrapped so their value lands on
  # stdout (a compiled program's top level has no return channel); statements
  # and declarations run as written. Parse and compile errors come back as
  # the result string; whatever the line prints arrives via stdout as usual.
  func eval(src :string) -> string:
    var text = src
    try:
      var expr = inspect.parse_expression(src)
      # An unresolved name is a FATAL runtime error in Roxal, not a catchable
      # one -- a typo would take the whole running app down, and no try/except
      # here could stop it. So check the names an expression mentions BEFORE
      # running it. Note a REPL line runs as its own program: it sees globals
      # and builtins, not the running app's variables or its imports.
      for n in inspect.walk(expr):
        if n.kind() == "Variable" and not defined(n.name):
          return "undefined: " + n.name
      text = "print(" + inspect.unparse(expr) + ")"
    except e:
      text = src
    try:
      var prog = inspect.parse(text + "\n", "<repl>")
      inspect.compile(prog, "<repl>")()
      return ""
    except e2:
      return string(e2)

# Data-flow diagram service: holds the open diagram DOCUMENTS -- inspect
# mirror trees -- keyed by file path, and applies the canvas's edit ops to
# them via dfdoc. The Monaco buffer remains the durable text; on any lost
# state ('no_document') the JS side simply re-opens from the buffer. Every
# method returns an {'ok': ...} envelope and never raises across the store
# boundary.
type Df actor:
  private var docs :dict = {}
  // Sampling cache: path -> {'rev','ran','map'}; `revs` is bumped by every
  // mutation so the cache can never answer for a stale document.
  private var revs :dict = {}
  private var scache :dict = {}
  private var pals :dict = {}   // per-document palette, for connect-time types

  private func _refresh_palette(path :string):
    var paths = []
    for m in dfdoc.doc_modules(docs[path]):
      for base in [host_dir('stdlib'), host_dir('data')]:
        paths.append(base + '/' + m + '.rox')
        paths.append(base + '/' + m + '/init.rox')   // directory modules (opencv)
    pals[path] = dfdoc.palette(paths)   // unreadable paths skip harmlessly

  private func _pal(path :string) -> list:
    if not (path in pals):
      _refresh_palette(path)
    return pals[path]

  private func _with_view(path :string) -> dict:
    var doc = docs[path]
    return {'ok': true, 'view': dfdoc.view(doc), 'source': dfdoc.save(doc),
            'ports': dfdoc.port_types(doc, _pal(path))}

  func create(path :string, name :string, clocks :list) -> dict:
    try:
      var r = dfdoc.new_document(name, clocks)
      if not r['ok']:
        return r
      docs[path] = r['doc']
      _refresh_palette(path)
      return _with_view(path)
    except e:
      return {'ok': false, 'error': string(e)}

  func open(path :string, source :string) -> dict:
    // Any mutation invalidates the sampling cache.
    var r0 = 0
    if path in revs:
      r0 = revs[path]
    revs[path] = r0 + 1
    try:
      var r = dfdoc.load(source)
      if not r['ok']:
        return r
      docs[path] = r['doc']
      _refresh_palette(path)
      return _with_view(path)
    except e:
      return {'ok': false, 'error': string(e)}

  func rules() -> dict:
    return {'ok': true, 'rules': dfdoc.type_rules()}

  func apply(path :string, op :dict) -> dict:
    // Any mutation invalidates the sampling cache.
    var r0 = 0
    if path in revs:
      r0 = revs[path]
    revs[path] = r0 + 1
    if not (path in docs):
      return {'ok': false, 'error': 'no_document'}
    try:
      var r = dfdoc.apply(docs[path], op, _pal(path))
      if r['ok']:
        if op['op'] == 'add_node' or op['op'] == 'add_import':
          _refresh_palette(path)   // a new node or import may add a module
        r['ports'] = dfdoc.port_types(docs[path], _pal(path))
      return r
    except e:
      return {'ok': false, 'error': string(e)}

  func save(path :string) -> dict:
    if not (path in docs):
      return {'ok': false, 'error': 'no_document'}
    return {'ok': true, 'source': dfdoc.save(docs[path])}

  func close(path :string) -> dict:
    // Any mutation invalidates the sampling cache.
    var r0 = 0
    if path in revs:
      r0 = revs[path]
    revs[path] = r0 + 1
    if path in docs:
      var kept = {}
      for k in docs:
        if k != path:
          kept[k] = docs[k]
      docs = kept
    if path in pals:
      var kept2 = {}
      for k2 in pals:
        if k2 != path:
          kept2[k2] = pals[k2]
      pals = kept2
    return {'ok': true}

  func palette(modules :list) -> dict:
    try:
      var paths = []
      for m in modules:
        paths.append(host_dir('stdlib') + '/' + m + '.rox')
      return {'ok': true, 'items': dfdoc.palette(paths)}
    except e:
      return {'ok': false, 'error': string(e)}

  # The palette for ONE document: every function of the modules it imports
  # (resolved against the standard library and the data directory) plus the
  # editor's base modules, so a fresh diagram is not empty. Items are
  # grouped by module on the client.
  func doc_palette(path :string, base :list) -> dict:
    if not (path in docs):
      return {'ok': false, 'error': 'no_document'}
    try:
      var items = []
      var seen = {}
      for it in _pal(path):
        seen[it['callee']] = true
        items.append(it)
      var paths = []
      for m in base:
        paths.append(host_dir('stdlib') + '/' + m + '.rox')
        paths.append(host_dir('stdlib') + '/' + m + '/init.rox')
      for it in dfdoc.palette(paths):
        if not (it['callee'] in seen):
          seen[it['callee']] = true
          items.append(it)
      // ONNX models from the workspace's catalog (<data>/models/catalog.json,
      // written by tools/nn-catalog.py): ports from the model's own metadata
      try:
        var cat = from_json(fileio.read_file(host_dir('data') + '/models/catalog.json'))
        for m in cat['models']:
          if 'missing' in m and m['missing']:
            continue
          var params = []
          for inp in m['inputs']:
            params.append({'name': inp['name'], 'type': 'tensor', 'has_default': false})
          var outs = []
          var onames = []
          for o in m['outputs']:
            outs.append('tensor')
            onames.append(o['name'])
          var label = m['name']
          if 'label' in m:
            label = m['label']
          var blurb = ''
          if 'blurb' in m:
            blurb = m['blurb']
          var license = ''
          if 'license' in m:
            license = m['license']
          var opset = nil
          if 'opset' in m:
            opset = m['opset']
          // 'doc' is what the editor shows for any palette entry; a model's
          // comes from the catalog, since the ONNX format's own doc_string
          // is empty in everything the usual exporters produce
          items.append({'kind': 'model', 'module': 'models', 'name': m['name'], 'label': label,
                        'callee': 'models.' + m['name'], 'file': m['file'],
                        'params': params, 'outputs': outs, 'output_names': onames,
                        'inputs': m['inputs'], 'outputs_meta': m['outputs'],
                        'doc': blurb, 'license': license, 'opset': opset})
      except ecat:
        var _no_catalog = ecat   // a workspace without models/ simply has no model nodes
      return {'ok': true, 'items': items, 'modules': dfdoc.doc_modules(docs[path])}
    except e:
      return {'ok': false, 'error': string(e)}

  func harness(path :string) -> dict:
    if not (path in docs):
      return {'ok': false, 'error': 'no_document'}
    try:
      return {'ok': true, 'source': dfdoc.harness(docs[path])}
    except e:
      return {'ok': false, 'error': string(e)}

  func check(path :string) -> dict:
    if not (path in docs):
      return {'ok': false, 'error': 'no_document'}
    try:
      return {'ok': true, 'diagnostics': dfdoc.check(docs[path])}
    except e:
      return {'ok': false, 'error': string(e)}

  # every diagram file under /data that can be placed as a node, except the
  # one being edited (a diagram cannot contain itself)
  func components(exclude :string = '') -> dict:
    try:
      var items = []
      var data_dir = host_dir('data')
      var entries = fileio.list_dir(data_dir)
      if entries == nil:
        entries = []
      for e in entries:
        var path = data_dir + '/' + e
        if path == exclude:
          continue
        if len(e) < 5 or e[len(e) - 4] != '.' or e[len(e) - 3] != 'r' or e[len(e) - 2] != 'o' or e[len(e) - 1] != 'x':
          continue
        try:
          var spec = dfdoc.component_spec(path)
          if spec['ok']:
            spec['file'] = e
            items.append(spec)
        except einner:
          continue
      return {'ok': true, 'items': items}
    except e:
      return {'ok': false, 'error': string(e)}

  func probe() -> dict:
    var names = []
    for s in inspect.signals(include_internal=true):
      names.append(s.info()['src_name'] + ':' + string(s.info()['src_line']))
    return {'ok': true, 'names': names}

  func sample(path :string) -> dict:
    if not (path in docs):
      return {'ok': false, 'error': 'no_document'}
    try:
      var stem = dfdoc._module_stem(path)
      // The editor polls this on a timer to refresh edge labels. Only the
      // signal reads below change between polls: emitting the harness and
      // parsing it into a mirror AST depend solely on the document, so cache
      // both against a revision that every mutation bumps. Without this each
      // refresh rebuilt a full mirror AST (and reparsed every referenced
      // sub-diagram) to answer with the same map as last time.
      var rev = 0
      if path in revs:
        rev = revs[path]
      if (not (path in scache)) or scache[path]['rev'] != rev:
        var ran0 = dfdoc.harness(docs[path])
        scache[path] = {'rev': rev, 'ran': ran0,
                        'map': dfdoc.live_map(ran0, host_dir('data'))}
      var c = scache[path]
      return {'ok': true,
              'values': dfdoc.live_values(docs[path], stem, c['ran'], host_dir('data'), c['map'])}
    except e:
      return {'ok': false, 'error': string(e)}

# Debugger control surface. Every method runs on this actor's own thread,
# which the host marks debug-excluded at spawn -- before the actor is
# runnable, so a breakpoint bound ahead of the run can never trap the
# debugger's own service thread. Being excluded, it keeps servicing the UI
# while the debuggee is stopped: the store's calls are the ONLY inbound work
# the host pump runs during a stop.
type Debug actor:
  func arm(stop_on_fatal :bool = true) -> dict:
    debug.arm(stop_on_fatal)
    return {'ok': true}

  func set_breakpoints(path :string, lines :list) -> dict:
    return {'ok': true, 'breakpoints': debug.set_breakpoints(path, lines)}

  func locations(path :string, line :int, end_line :int) -> dict:
    return {'ok': true, 'lines': debug.locations(path, line, end_line)}

  func pause() -> dict:
    return {'ok': debug.pause()}

  func resume() -> dict:
    return {'ok': debug.resume()}

  func step(thread_id :int, mode :string = 'next') -> dict:
    return {'ok': debug.step(thread_id, mode)}

  func state() -> dict:
    return debug.state()

  func threads() -> dict:
    return {'ok': true, 'threads': debug.threads()}

  func stack(thread_id :int) -> dict:
    return {'ok': true, 'frames': debug.stack(thread_id, 0, 0)}

  func scopes(frame_id :int) -> dict:
    return {'ok': true, 'scopes': debug.scopes(frame_id)}

  func variables(ref :int, start :int = 0, count :int = 0) -> dict:
    return {'ok': true, 'variables': debug.variables(ref, start, count)}

  func evaluate(frame_id :int, expr :string) -> dict:
    return debug.evaluate(frame_id, expr)

proc _ensure_ide():
  expose("ide", Ide())
  expose("workspace", Workspace())
  expose("df", Df())
  # (The "debug" control store is HOST-constructed and exposed by the web
  # module's C++ side under an armed session -- never from script code, so
  # the control capability is unforgeable.)
