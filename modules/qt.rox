// qt — drive a QML/QtQuick UI from Roxal (Qt 6).
//
// The VM stays in control: Qt is pumped cooperatively on the main thread (no
// Qt exec()), so the single Roxal/UI thread runs both the script and all Qt
// event handling. An Engine loads QML (root must be a Window) and run() blocks
// the script until the last window closes or QML Qt.quit() is requested.
//
//   import qt
//   var engine = qt.Engine()
//   engine.load("main.qml")        // or engine.load_string("import QtQuick ...")
//   engine.run()                   // blocks until the window closes / Qt.quit()

// Escape hatches for property/method names that aren't valid Roxal identifiers
// (e.g. "z-order") or for fully-dynamic access. Native syntax (item.name) is
// preferred; these take the name as a string.
@builtin
func get(item, name:string):
  """Read property `name` from a Qt item (or a bound callable for a method name)."""

@builtin
func set(item, name:string, value):
  """Set property `name` on a Qt item."""

@builtin
func call(item, name:string, args=nil):
  """Invoke method `name` on a Qt item with an optional list of args; returns the result."""

@builtin
func connect(item, name:string, handler):
  """Connect Qt signal `name` on `item` to a callback (invoked with the signal's
  args). Returns a connection id for qt.disconnect. Prefer native `item.onName(fn)`."""

@builtin
func on(item, name:string):
  """Return the event for Qt signal `name` on `item`, for `when … occurs`.
  Prefer native `item.name` (e.g. `when btn.clicked occurs`)."""

@builtin
func disconnect(connection):
  """Remove a signal callback connection (the id returned by connect / item.onName)."""

@builtin
type Engine object:
  """A QML application engine: loads QML and runs the Qt UI loop."""

  var _native   // ForeignPtr to the C++ QQmlApplicationEngine (module-owned)

  @builtin
  proc init():
    """Create a QML application engine (creates the QGuiApplication on first use)."""

  @builtin
  proc load(path:string):
    """Load QML from a file. The QML root object must be a Window."""

  @builtin
  proc load_string(qml:string):
    """Load QML from an inline string. The QML root object must be a Window."""

  @builtin
  proc run():
    """Block until the last window closes or QML Qt.quit() is requested, pumping
    the Qt UI loop meanwhile. Returns so the script can finish and tear down."""

  @builtin
  proc quit():
    """Request that run() unblock (e.g. from a callback or event)."""

  @builtin
  func find(name:string):
    """Find a QML item by objectName anywhere under the loaded QML (recursive).
    Returns an item handle, or nil if not found. (QML `id` is not findable at
    runtime; set `objectName` on items you want to reach.)"""

  @builtin
  func root():
    """Return the engine's root object as an item handle (nil if nothing loaded)."""
