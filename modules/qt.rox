// qt — drive a QML/QtQuick UI from Roxal (Qt 6).
//
// The VM stays in control: Qt is pumped cooperatively on the main thread (no
// Qt exec()), so the single Roxal/UI thread runs both the script and all Qt
// event handling. An Engine loads QML (root must be a Window) and run() blocks
// the script until the last window closes or QML Qt.quit() is requested.
//
//   import qt
//   var engine = qt.Engine()
//   engine.load("main.qml")        // or engine.load_string("import QtQuick ...")
//   engine.run()                   // blocks until the window closes / Qt.quit()

// Escape hatches for property/method names that aren't valid Roxal identifiers
// (e.g. "z-order") or for fully-dynamic access. Native syntax (item.name) is
// preferred; these take the name as a string.
@builtin
func get(item, name:string):
  """Read property `name` from a Qt item (or a bound callable for a method name)."""

@builtin
func set(item, name:string, value):
  """Set property `name` on a Qt item."""

@builtin
func call(item, name:string, args=nil):
  """Invoke method `name` on a Qt item with an optional list of args; returns the result."""

@builtin
func connect(item, name:string, handler):
  """Connect Qt signal `name` on `item` to a callback (invoked with the signal's
  args). Returns a connection id for qt.disconnect. Prefer native `item.onName(fn)`."""

@builtin
func on(item, name:string):
  """Return the event for Qt signal `name` on `item`, for `when … occurs`.
  Prefer native `item.name` (e.g. `when btn.clicked occurs`)."""

@builtin
func disconnect(connection):
  """Remove a signal callback connection (the id returned by connect / item.onName)."""


// Cooperative pumping — drive a UI interactively (e.g. from the REPL) without run().
// Property reads/writes already take effect immediately; pumping is what lets the UI
// repaint and lets queued signal handlers / qt.every timers fire.

@builtin
func process_events(max_ms=nil):
  """Service all currently-pending Qt events once (repaints, queued signal handlers /
  callbacks) and return — a one-shot pump. With `max_ms`, process for up to that many
  milliseconds. Handy at the REPL: set a property, then process_events() to see it, or
  to let a queued click handler run. See also engine.run_for() for a timed pump."""

@builtin
func every(ms, handler):
  """Call `handler` (no args) about every `ms` milliseconds while the Qt loop is being
  pumped — under run(), engine.run_for(), or after process_events(). Returns a timer
  item handle: stop it with `timer.stop()` (resume with `timer.start()`, retime with
  `timer.interval = ms`). Runs on the main UI thread, so the handler may touch Qt
  items freely."""

@builtin
func set_style(name:string):
  """Select the Qt Quick Controls style for the app — one of the installed styles
  ("Basic", "Fusion", "Material", "Universal", "Imagine"). Call this once, before
  load()/load_string() (it has no effect once a control has been created). Raises if
  the style isn't installed."""

@builtin
func notify(obj, name=nil):
  """Push a change of `obj` (a Roxal object exposed to QML via set_context_property)
  to QML. Roxal-side property *assignments* notify automatically; use this only to
  force a push after mutating a contained list/dict in place. With `name`, push just
  that property; otherwise push all. No-op if `obj` isn't exposed."""


// Qt/QML diagnostic messages (warnings, QML TypeErrors, etc.) print to stderr by
// default, which can clutter a console shared with print() output. These redirect or
// silence them (process-wide; Roxal has no general logging module yet). Fatal errors
// still abort. The default (stderr) is restored when the script's UI run completes.

@builtin
func log_to_file(path:string):
  """Redirect Qt/QML messages to the file at `path` (appended, created if needed),
  keeping them out of the console."""

@builtin
func log_silence():
  """Discard all Qt/QML messages (fatal errors still abort)."""

@builtin
func log_to_stderr():
  """Restore the default: Qt/QML messages print to stderr."""

@builtin
type Engine object:
  """A QML application engine: loads QML and runs the Qt UI loop."""

  var _native   // ForeignPtr to the C++ QQmlApplicationEngine (module-owned)

  @builtin
  proc init():
    """Create a QML application engine (creates the QGuiApplication on first use)."""

  @builtin
  proc load(path:string):
    """Load QML from a file. The QML root object must be a Window."""

  @builtin
  proc load_string(qml:string):
    """Load QML from an inline string. The QML root object must be a Window."""

  @builtin
  proc run():
    """Block until the last window closes or QML Qt.quit() is requested, pumping
    the Qt UI loop meanwhile. Returns so the script can finish and tear down."""

  @builtin
  proc run_for(ms):
    """Pump the Qt UI loop for about `ms` milliseconds, then return — a bounded,
    non-blocking alternative to run() for interactive / REPL use (the script keeps
    control). Services repaints, queued signal handlers, and qt.every timers while it
    runs; returns early if a window is closed. Use ms<=0 to just drain pending events
    once (like qt.process_events())."""

  @builtin
  proc quit():
    """Request that run() unblock (e.g. from a callback or event)."""

  @builtin
  func find(name:string):
    """Find a QML item by objectName anywhere under the loaded QML (recursive).
    Returns an item handle, or nil if not found. (QML `id` is not findable at
    runtime; set `objectName` on items you want to reach.)"""

  @builtin
  func root():
    """Return the engine's root object as an item handle (nil if nothing loaded)."""

  @builtin
  proc set_context_property(name:string, value):
    """Expose `value` to QML under `name` (e.g. a qt.ListModel for a ListView, a Qt
    item handle, or a plain value). Call before load(); QML then references `name`."""

  @builtin
  func create_component(path:string):
    """Compile a reusable qt.Component from the QML file at `path` (resolved like
    load()). Instantiate items from it with Component.create(). Raises on a compile
    error."""

  @builtin
  func create_component_string(qml:string):
    """Compile a reusable qt.Component from an inline QML `qml` string (its relative
    asset URLs / imports resolve next to the calling script, like load_string()).
    Raises on a compile error."""


@builtin
type Component object:
  """A reusable QML component compiled from a file or inline source, obtained from an
  Engine (engine.create_component / create_component_string). Instantiate items from it
  at runtime with create(), QML's Qt.createComponent + createObject pattern."""

  var _native   // ForeignPtr to the C++ QQmlComponent (engine-owned)

  @builtin
  func create(parent=nil, props=nil):
    """Instantiate the component, returning a Qt item handle (like engine.find()).
    `props` is an optional dict of initial property values, set before the item is
    completed (so its bindings see them). With a non-nil `parent` item, the new item is
    parented to it — for ownership (destroyed with the parent) and, for visual items, for
    layout (it appears under the parent). With `parent` nil, the item is owned by the
    engine (kept alive until teardown) so you can parent it yourself later. Raises if
    instantiation fails."""


@builtin
type ListModel object:
  """A list model for a QML ListView/Repeater, backed by Roxal row objects. Each row
  is an object instance; the row type's public properties become the model's roles
  (columns), so a delegate binds to them by name (e.g. `model.<property>`). Reads are
  cheap property look-ups; edits from the UI write back through the row's property."""

  var _native   // ForeignPtr to the C++ RoxalListModel (module-owned)

  @builtin
  proc init(row_type, initial=nil):
    """Create a list model whose rows are instances of `row_type` — an object type or
    an interface (its public properties become the roles, in declared order). A
    `const` property is a read-only role; a writable property is editable from the UI.
    Optionally seed with `initial`, a list of rows. Each row must be an instance of
    (or, for an interface, implement) `row_type`."""

  @builtin
  func count() -> int:
    """The number of rows."""

  @builtin
  func row(i:int):
    """The row object at index `i` (nil if out of range)."""

  @builtin
  proc append(row):
    """Append a row to the end of the model."""

  @builtin
  proc insert(i:int, row):
    """Insert `row` before index `i`."""

  @builtin
  proc remove(i:int):
    """Remove the row at index `i`."""

  @builtin
  proc move(from_index:int, to_index:int):
    """Move the row at `from_index` to `to_index`."""

  @builtin
  proc clear():
    """Remove all rows."""

  @builtin
  proc set_rows(rows):
    """Replace all rows with the rows in `rows` (a single model reset)."""

  @builtin
  proc begin_reset():
    """Begin a batch structural change; pair with end_reset(). Mutators called in
    between are coalesced into a single model reset (no per-operation signals)."""

  @builtin
  proc end_reset():
    """End a begin_reset() batch."""

  @builtin
  proc row_changed(i:int):
    """Notify the view that every role of row `i` changed (call after editing the row
    object's properties directly)."""

  @builtin
  proc cell_changed(i:int, role:string):
    """Notify the view that `role` of row `i` changed."""

  @builtin
  proc set(i:int, role:string, value):
    """Set `role` of row `i` to `value` and notify the view (a no-op if unchanged)."""


@builtin
type TreeModel object:
  """A tree model for a QML TreeView, backed by Roxal node objects. A node is an object
  instance; its child nodes live in a `children` list property (which is structural, so
  it is NOT a role). The node type's OTHER public properties are the roles, bound in a
  delegate by name (e.g. `model.<property>`). All operations take a parent node (or nil
  for the root level)."""

  var _native   // ForeignPtr to the C++ RoxalTreeModel (module-owned)

  @builtin
  proc init(node_type, roots=nil):
    """Create a tree model whose nodes are instances of `node_type`. Each node's child
    nodes are in its `children` list. Optionally seed with `roots`, a list of top-level
    nodes (each an instance of / implementing `node_type`); their subtrees come along in
    the node objects' `children`."""

  @builtin
  func count(parent=nil) -> int:
    """The number of children of `parent` (the root-level count if `parent` is nil)."""

  @builtin
  func child(parent, i:int):
    """The `i`-th child of `parent` (or the `i`-th root if `parent` is nil); nil if OOB."""

  @builtin
  func parent_of(node):
    """The parent node of `node` (nil if `node` is a root or not in the tree)."""

  @builtin
  proc append(parent, node):
    """Append `node` as a child of `parent` (a root if `parent` is nil)."""

  @builtin
  proc insert(parent, i:int, node):
    """Insert `node` before child index `i` of `parent` (a root if `parent` is nil)."""

  @builtin
  proc remove(parent, i:int):
    """Remove child `i` of `parent` (a root if `parent` is nil)."""

  @builtin
  proc move(parent, from_index:int, to_index:int):
    """Move a child of `parent` from `from_index` to `to_index`."""

  @builtin
  proc clear(parent=nil):
    """Remove all children of `parent` (all roots if `parent` is nil)."""

  @builtin
  proc begin_reset():
    """Begin a batch structural change; pair with end_reset(). Mutators called in
    between are coalesced into a single model reset (no per-operation signals)."""

  @builtin
  proc end_reset():
    """End a begin_reset() batch."""

  @builtin
  proc node_changed(node):
    """Notify the view that every role of `node` changed (call after editing the node
    object's properties directly)."""

  @builtin
  proc cell_changed(node, role:string):
    """Notify the view that `role` of `node` changed."""

  @builtin
  proc set(node, role:string, value):
    """Set `role` of `node` to `value` and notify the view (a no-op if unchanged)."""


@builtin
type TableModel object:
  """A table model for a QML TableView, backed by Roxal row objects. Each row is an object
  instance; you choose which of its properties are columns (and in what order), each with a
  header. A TableView delegate binds the cell value as `model.display` (the column comes from
  the delegate's `column`); a HorizontalHeaderView shows the headers. A writable column is
  editable from the UI, a `const` column is read-only."""

  var _native   // ForeignPtr to the C++ RoxalTableModel (module-owned)

  @builtin
  proc init(row_type, columns=nil, initial=nil):
    """Create a table model whose rows are instances of `row_type`. `columns` selects the
    columns: a list whose entries are either a property name (e.g. "qty" — the header is the
    name) or a `[name, header]` pair (e.g. ["qty", "Quantity"]); nil uses all of the type's
    public properties in declared order. Optionally seed with `initial`, a list of rows (each
    an instance of / implementing `row_type`)."""

  @builtin
  func count() -> int:
    """The number of rows."""

  @builtin
  func column_count() -> int:
    """The number of columns."""

  @builtin
  func row(i:int):
    """The row object at row index `i` (nil if out of range)."""

  @builtin
  proc append(row):
    """Append a row to the end of the model."""

  @builtin
  proc insert(i:int, row):
    """Insert `row` before row index `i`."""

  @builtin
  proc remove(i:int):
    """Remove the row at index `i`."""

  @builtin
  proc move(from_index:int, to_index:int):
    """Move the row at `from_index` to `to_index`."""

  @builtin
  proc clear():
    """Remove all rows."""

  @builtin
  proc set_rows(rows):
    """Replace all rows with the rows in `rows` (a single model reset)."""

  @builtin
  proc begin_reset():
    """Begin a batch structural change; pair with end_reset(). Mutators called in
    between are coalesced into a single model reset (no per-operation signals)."""

  @builtin
  proc end_reset():
    """End a begin_reset() batch."""

  @builtin
  proc row_changed(i:int):
    """Notify the view that every column of row `i` changed (call after editing the row
    object's properties directly)."""

  @builtin
  proc cell_changed(i:int, column:string):
    """Notify the view that `column` (a column's property name) of row `i` changed."""

  @builtin
  proc set(i:int, column:string, value):
    """Set `column` (a column's property name) of row `i` to `value` and notify the view
    (a no-op if unchanged)."""


@builtin
type SortFilterModel object:
  """A sorted / filtered view over a qt.ListModel for a QML ListView, without changing the
  underlying model. Sort by a role and/or filter rows by a role substring; the view tracks
  the source live (appends/edits to the source flow through). Expose it (not the source) via
  set_context_property; the delegate binds `model.<role>` exactly as for the source model."""

  var _native   // ForeignPtr to the C++ QSortFilterProxyModel (module-owned)

  @builtin
  proc init(source):
    """Wrap `source` (a qt.ListModel) in a sort/filter view."""

  @builtin
  proc sort_by(role:string, descending=false):
    """Sort the view by `role` (a role of the source's row type), ascending by default."""

  @builtin
  proc filter(role:string, text:string):
    """Show only rows whose `role` value contains `text` (case-insensitive substring)."""

  @builtin
  proc clear_filter():
    """Remove the filter (show all rows)."""

  @builtin
  func count() -> int:
    """The number of visible (post-filter) rows."""

  @builtin
  func row(i:int):
    """The source row object at visible index `i` (nil if out of range)."""
