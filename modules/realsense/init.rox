# Intel RealSense binding for Roxal — pure Roxal over a thin C shim
# (librsshim.so) around librealsense2.
#
# Depth images are uint16 tensors of shape [height, width, 1] in raw sensor
# units; multiply by `depth_scale` (or call `depth_meters`) for metres. Colour
# images are uint8 [height, width, 3] RGB — the same convention as the opencv
# and media modules, so frames flow straight into them without conversion.
#
# Unlike a plain V4L2 capture, this carries the camera's factory calibration:
# intrinsics, depth<->colour extrinsics, the metric depth scale, and hardware
# depth-to-colour alignment.

import sys
rslib = sys.loadlib('./librsshim.so')


#
# internal shim declarations

@cfunc(lib=rslib, cname='rs_version', ret='const char*')
func _version() -> string:
  _

@cfunc(lib=rslib, cname='rs_last_error', ret='const char*')
func _last_error() -> string:
  _

# The shim static_asserts the SDK's major/minor at build time; this catches a
# librsshim.so left over from a different SDK generation.
if _version()[0:2] != '2.':
  raise RuntimeException('realsense module expects librealsense 2.x but librsshim.so reports ' + _version() + ' — rebuild the shim (modules/realsense/shim/build.sh)')

@cfunc(lib=rslib, cname='rs_create_context', ret='void*', free='rs_delete_context')
func _create_context():
  _

@cfunc(lib=rslib, cname='rs_device_count', args='void* ctx', ret='int')
func _device_count(ctx) -> int:
  _

@cfunc(lib=rslib, cname='rs_device_info', args='void* ctx, int index, int info', ret='const char*')
func _device_info(ctx, index: int, info: int) -> string:
  _

@cfunc(lib=rslib, cname='rs_device_reset', args='void* ctx, int index', ret='int', blocking=true)
func _device_reset(ctx, index: int) -> int:
  _

@cfunc(lib=rslib, cname='rs_open', args='void* ctx, const char* serial, int enable_depth, int depth_w, int depth_h, int enable_color, int color_w, int color_h, int enable_ir, int enable_imu, int fps, int align', ret='void*', free='rs_close', blocking=true)
func _open(ctx, serial: string, enable_depth: int, depth_w: int, depth_h: int, enable_color: int, color_w: int, color_h: int, enable_ir: int, enable_imu: int, fps: int, align: int):
  _

@cfunc(lib=rslib, cname='rs_stop', args='void* h', blocking=true)
proc _stop(h):
  _

@cfunc(lib=rslib, cname='rs_read', args='void* h, void* depth, void* color, void* ir, int timeout_ms', ret='int', blocking=true)
func _read(h, depth, color, ir, timeout_ms: int) -> int:
  _

