func imagenet_label(cls: int) -> string:
  """The ImageNet class name for a classifier's class number (MobileNet's
  top_class), such as 'tabby' or 'coffee mug'. An unknown number comes back
  as 'class N'."""
  if cls < 0 or cls >= 1000:
    return 'class ' + string(cls)
  if cls < 250:
    return IMAGENET_0[cls]
  if cls < 500:
    return IMAGENET_1[cls - 250]
  if cls < 750:
    return IMAGENET_2[cls - 500]
  return IMAGENET_3[cls - 750]

# --- blobs: the bright pixels of a frame, as a target -------------------------

func blob_mask(image: tensor, threshold: int = 90) -> tensor:
  """The pixels at least as bright as `threshold` (grey level 0..255): a
  uint8 [H, W, 1] mask, 255 where they pass."""
  if _empty(image):
    return tensor([0, 0, 1], dtype='uint8')
  var gray = image
  var s = image.shape()
  if len(s) == 2:
    gray = image.reshape(s[0], s[1], 1)
  else:
    if s[2] != 1:
      gray = opencv.grayscale(image)
  return opencv.threshold(gray, real(threshold) - 1.0)

func blob_target(image: tensor, depth: tensor, threshold: int = 90) -> vector:
  """The centroid of the pixels at least as bright as `threshold`:
  [x y area depth] -- pixels, pixel count, metres -- or [-1 -1 0 0] when
  none pass. The depth is read at the centroid."""
  if _empty(image):
    return [(-1.0) (-1.0) 0.0 0.0]
  # the centroid of every passing pixel is the area-weighted mean of the
  # components' centroids (one native pass, no coordinate grids)
  var area = 0.0
  var sx = 0.0
  var sy = 0.0
  for b in opencv.connected_components(blob_mask(image, threshold), 1):
    area = area + b.area
    sx = sx + b.area * b.center_x
    sy = sy + b.area * b.center_y
  if area < 1.0:
    return [(-1.0) (-1.0) 0.0 0.0]
  var cx = sx / area
  var cy = sy / area
  var dz = 0.0
  if depth != nil and not _empty(depth):
    var r = int(math.floor(cy))
    var c = int(math.floor(cx))
    if r >= 0 and r < depth.shape()[0] and c >= 0 and c < depth.shape()[1]:
      if len(depth.shape()) == 3:
        dz = depth[r, c, 0]
      else:
        dz = depth[r, c]
  return [(cx) (cy) (area) (dz)]

func target_found(target: vector) -> bool:
  """Whether a blob target found anything (its area is not zero)."""
  if len(target) < 4:
    return false
  return target[2] > 0.0

func target_x(target: vector) -> real:
  """The x (column) of a blob target, in pixels."""
  if len(target) < 4:
    return -1.0
  return target[0]

func target_y(target: vector) -> real:
  """The y (row) of a blob target, in pixels."""
  if len(target) < 4:
    return -1.0
  return target[1]

func target_depth(target: vector) -> real:
  """The depth at a blob target, in metres."""
  if len(target) < 4:
    return -1.0
  return target[3]

# --- marks for a camera's preview ---------------------------------------------
# What a block found, drawn by an editor on the preview of the camera that fed
# it. An overlay is a dict {'overlay': [marks], 'seq': frame}; each mark is
# {'kind': 'point' | 'box' | 'polyline' | 'text', 'pts': [...], 'text', 'seq'}
# with coordinates NORMALISED to the image (0..1), so it can be drawn on a
# preview of any size. `seq` names the frame the marks belong to (0: any).

func detections_overlay(dets: list, seq: int = 0) -> dict:
  """Detections (from dfine_detections) as boxes with their labels."""
  var marks = []
  for d in dets:
    marks.append({'kind': 'box', 'pts': [(d[0]) (d[1]) (d[2]) (d[3])], 'text': '', 'seq': seq})
    marks.append({'kind': 'text', 'pts': [(d[0]) (d[1])], 'text': coco_label(int(d[5])) + ' ' + string(int(d[4] * 100.0)) + '%', 'seq': seq})
  return {'overlay': marks, 'seq': seq}

func blob_overlay(target: vector, image: tensor, seq: int = 0) -> dict:
  """A blob target as a point at its centroid labelled with its depth;
  nothing when no blob was found."""
  var marks = []
  if len(target) >= 4 and target[2] > 0.0 and not _empty(image):
    var x = target[0] / real(image.shape()[1])
    var y = target[1] / real(image.shape()[0])
    marks.append({'kind': 'point', 'pts': [(x) (y)], 'text': '', 'seq': seq})
    var label = 'target'
    if target[3] > 0.0:
      label = label + ' ' + string(int(target[3] * 1000.0)) + ' mm'
    marks.append({'kind': 'text', 'pts': [(x) (y)], 'text': label, 'seq': seq})
  return {'overlay': marks, 'seq': seq}

func markers_overlay(markers: list, image: tensor, seq: int = 0) -> dict:
  """Fiducial markers -- AprilTags, ArUco markers, anything with an `id` and
  four `corners` in pixels -- as outlines labelled with their ids."""
  var marks = []
  if _empty(image):
    return {'overlay': marks, 'seq': seq}
  var w = real(image.shape()[1])
  var h = real(image.shape()[0])
  for m in markers:
    var c = m.corners
    marks.append({'kind': 'polyline', 'pts': [(c[0, 0] / w) (c[0, 1] / h) (c[1, 0] / w) (c[1, 1] / h) (c[2, 0] / w) (c[2, 1] / h) (c[3, 0] / w) (c[3, 1] / h) (c[0, 0] / w) (c[0, 1] / h)], 'text': '', 'seq': seq})
    var mx = (c[0, 0] + c[1, 0] + c[2, 0] + c[3, 0]) / 4.0
    var my = (c[0, 1] + c[1, 1] + c[2, 1] + c[3, 1]) / 4.0
    marks.append({'kind': 'text', 'pts': [(mx / w) (my / h)], 'text': string(m.id), 'seq': seq})
  return {'overlay': marks, 'seq': seq}

# --- camera observations -------------------------------------------------------
# A camera's `observation`: one frame with its image, depth, number and stamps
# as one value (any object with those fields). These take it apart for blocks
# that want a tensor.

func frame_image(frame) -> tensor:
  """The image of a camera observation ([H, W, 3] uint8), or an empty
  tensor before the first frame."""
  if frame == nil or frame.image == nil:
    return tensor([0, 0, 3], dtype='uint8')
  return frame.image

func frame_depth(frame) -> tensor:
  """The depth map of a camera observation ([H, W] float32 metres), or an
  empty tensor when it has none."""
  if frame == nil or frame.depth == nil:
    return tensor([0, 0], dtype='float32')
  return frame.depth

func frame_seq(frame) -> int:
  """The frame number of a camera observation (0 before the first frame):
  pass it to an overlay block so its marks pair with the frame they came
  from."""
  if frame == nil:
    return 0
  return frame.seq

func frame_pose(frame):
  """Where the camera was when it took the frame: its pose in the world as
  [x y z qw qx qy qz], or nil when its backend cannot say (or before the
  first frame). Draw it with scene_frame."""
  if frame == nil:
    return nil
  return frame.capture_pose

# --- 3D scenes -------------------------------------------------------------------
# What a block wants drawn in a 3D view of the cell: an output whose view is
# 'scene' draws a scene, a dict {'scene': [items]}; each item is a frame drawn
# as axes ({'kind': 'frame', 'pose', 'text'}) or a body of the site drawn as a
# ghost ({'kind': 'body', 'body', 'pose'}). A pose is a Pose (in its frame), a
# Transform (the world) or [x y z qw qx qy qz] in the world (frame_pose's).
# Each block makes a scene of its own; scene_join puts two together.

func scene_frame(pose, text: string = '') -> dict:
  """Axes at `pose`, as a scene: wire it to a 3D view output, or join it to
  others with scene_join. Nothing while the pose is nil."""
  if pose == nil:
    return {'scene': []}
  return {'scene': [{'kind': 'frame', 'pose': pose, 'text': text}]}

func scene_body(body: string, pose) -> dict:
  """A ghost of the site's body named `body` (and the bodies hanging from it)
  at `pose`, as a scene: a part where a tracker says it is, say. Nothing
  while the pose is nil."""
  if pose == nil:
    return {'scene': []}
  return {'scene': [{'kind': 'body', 'body': body, 'pose': pose}]}

func scene_join(a: dict, b: dict) -> dict:
  """Two scenes as one: everything either draws."""
  var items = []
  for s in [a, b]:
    if s != nil and ('scene' in s):
      for it in s['scene']:
        items.append(it)
  return {'scene': items}
