# inspect — source introspection for tools, editors and IDEs.
#
# Two surfaces:
#   1. AST access: parse() turns Roxal source into a tree of mirror node
#      objects (one class per AST node kind, generated below).  The tree is
#      plain Roxal data — read it, edit it with ordinary assignment, walk it.
#   2. Live dataflow-network introspection (network(), signals(), ...).
#
# Mirror nodes carry source positions (start_line/start_col/end_line/end_col;
# lines from 1, columns from 0), a parent back-reference, and comment
# decorations (leading_comments / trailing_comment / blank_lines_before) at
# statement/declaration granularity, so editors can round-trip comments.
# Positions describe the parse they came from; they go stale after edits.

# ---- mirror-node base classes --------------------------------------------

type Node object:
  # base of every AST mirror node
  var start_line:int = 0
  var start_col:int = 0
  var end_line:int = 0
  var end_col:int = 0
  var parent                     # enclosing node; nil at the File root
  var deduced_type               # deduced type as a string, or nil
  var annotations = []           # Annotation nodes (@foo(...))
  var leading_comments = []      # comment lines directly above (list of string)
  var trailing_comment           # same-line comment after the node, or nil
  var blank_lines_before:int = 0 # blank lines directly above

  proc init(*):
    """construct a node, properties as named arguments"""

  func kind() -> string:
    return 'Node'

  func children() -> list:
    var cs = []
    for a in annotations:
      cs.append(a)
    return cs


type Arg object extends Node:
  # one argument of a Call or Annotation (also used for enum labels):
  # a name (nil when positional) and a value expression
  var name
  var value

  proc init(*):
    """construct an Arg, properties as named arguments"""

  func kind() -> string:
    return 'Arg'

  func children() -> list:
    var cs = []
    for a in annotations:
      cs.append(a)
    if value != nil:
      cs.append(value)
    return cs


type ExceptClause object extends Node:
  # one 'except' clause of a TryStatement
  var type_expr    # exception type expression, or nil
  var name         # binding name, or nil
  var body         # Suite

  proc init(*):
    """construct an ExceptClause, properties as named arguments"""

  func kind() -> string:
    return 'ExceptClause'

  func children() -> list:
    var cs = []
    for a in annotations:
      cs.append(a)
    if type_expr != nil:
      cs.append(type_expr)
    if body != nil:
      cs.append(body)
    return cs


# ---- module functions -----------------------------------------------------

func walk(node) -> list:
  """all nodes of the subtree rooted at node, preorder (node first)"""
  var result = [node]
  for c in node.children():
    for d in walk(c):
      result.append(d)
  return result


@builtin
func parse(source:string, name:string='fragment', tolerant:bool=false):
  """parse Roxal source into a mirror-node tree; returns the File node.
  Raises on a syntax error unless tolerant=true, which instead returns a dict
  with keys 'tree' and 'errors' (a list of dicts with keys 'line', 'col' and
  'message').  On errors the tree is PARTIAL: damaged statements are pruned
  and every intact one survives — nil only when nothing was recoverable"""

@builtin
func parse_file(path:string):
  """parse the Roxal source file at path; returns the File node (raises on
  a syntax error or unreadable file)"""

@builtin
func parse_expression(source:string):
  """parse a source fragment as an expression; returns the expression node
  (raises on a syntax error)"""

@builtin
func parse_statement(source:string):
  """parse a source fragment as a statement; returns the statement node
  (raises on a syntax error)"""

@builtin
func parse_declaration(source:string):
  """parse a source fragment as a declaration (type/func/var, or a plain
  statement); returns the node (raises on a syntax error)"""

@builtin
func compile(node, name:string='anonymous'):
  """compile a File mirror tree; returns a callable that runs the program's
  top level when invoked.  The tree is rendered with unparse() first, so
  compile errors and positions refer to that canonical text"""

@builtin
func unparse(node):
  """render a mirror-node tree back to canonical Roxal source text.
  Formatting is normalized (2-space indents, ASCII operators); comment
  decorations are re-emitted.  parse(unparse(t)) is structurally equal
  to t.  Works on any node: a File renders as a full program, expressions
  as expression text"""


# ---- live dataflow-network introspection ----------------------------------
# Read-only snapshots of the running signal network.  Signals are returned as
# borrowed references: reading .value/.name is always safe, and dropping them
# never tears down network parts.  Ids are stable process-unique keys shared
# between signals and nodes; src_line/src_col are the source location that
# created the node/signal (0 = unknown), correlating the graph back to code.

type Port object:
  # one input or output port of a DataflowNode
  var name:string = ''
  var index:int = 0          # input latency: -1 = one period ago; 0 otherwise
  var has_default:bool = false
  var sig                    # the connected signal ('signal' is a keyword)

  proc init(*):
    """construct a Port, properties as named arguments"""


type DataflowNode object:
  # one function node of the live dataflow network
  var id:int = 0
  var name:string = ''
  var period_us:int = 0
  var src_name:string = ''
  var src_line:int = 0
  var src_col:int = 0
  var inputs = []            # list of Port
  var outputs = []           # list of Port

  proc init(*):
    """construct a DataflowNode, properties as named arguments"""


type Network object:
  # a connected subnetwork (island) of the live dataflow graph
  var nodes = []             # list of DataflowNode
  var signals = []           # list of signal (borrowed references)
  var tick_period_us:int = 0
  var background:bool = false

  proc init(*):
    """construct a Network, properties as named arguments"""


# Per-signal queries are SIGNAL METHODS (importing inspect adds them):
# any plain function taking a signal argument would be lifted into a dataflow
# node by the engine, so they cannot be module functions.
#   sig.network() -> Network|nil   the island containing sig
#   sig.info()    -> dict          id, name, freq, domain, source/clock/
#                                  running/event_driven/internal/derived,
#                                  base + base_index (derived signals), and
#                                  src_name/src_line/src_col provenance

@builtin
func networks():
  """all connected subnetworks (islands) of the live dataflow graph"""

@builtin
func signals(include_internal:bool=false):
  """all registered signals (borrowed references); implicit variable-monitor
  signals are excluded unless include_internal=true"""


